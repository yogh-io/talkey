# talkey configuration. Copy to ~/.config/talkey/talkey.env and edit.
#
#   mkdir -p ~/.config/talkey
#   cp /usr/share/talkey/config/talkey.env.example ~/.config/talkey/talkey.env
#
# Format: KEY=value, one per line, #
# comments, quotes optional. Double quotes allow escaped quotes/backslashes.
# Values are literal; no shell code runs. Services use this same parser.
# Only TALKEY_* names are read; anything else is ignored.
#
# Every value here is a default that already works. Nothing needs setting - this
# file exists so you never have to edit a script or thread `env VAR=x` through
# your i3 config. A variable already set in the environment WINS over this file,
# so a per-binding override (`env TALKEY_LANG=de talkey dictate press`) still
# takes effect.
#
# Uncomment what you want to change.

# --- speech to text --------------------------------------------------------
#TALKEY_WHISPER_URL=http://127.0.0.1:8910/inference
#TALKEY_MODEL_NAME=large-v3-turbo     # which model the server loads
#TALKEY_MODEL=                        # full path to a .bin, skipping the search
#TALKEY_WHISPER_SERVER=               # full path to the whisper-server binary
#TALKEY_WHISPER_HOST=127.0.0.1
#TALKEY_WHISPER_PORT=8910
#TALKEY_WHISPER_THREADS=6
#TALKEY_LANG=en                       # whisper language code you dictate in
# A second language, for the `talkey dictate-alt` binding. Any code whisper
# knows (de, fr, es, ja, ...). Unset means you only dictate in one language, and
# the cheat sheet drops that row. A multilingual model is required either way.
#TALKEY_LANG2=

# --- microphone ------------------------------------------------------------
#TALKEY_SOURCE=default                # pulse source; see `pactl list sources short`
#TALKEY_SAMPLE_RATE=16000             # whisper uses 16k; 48000 keeps fuller archives (about 3x the disk)
#TALKEY_CHANNELS=1
# Auto mode detects speech on 16 kHz mono. Its takes are mono, kept at 32 or 48 kHz when
# TALKEY_SAMPLE_RATE is one of those, and at 16 kHz otherwise.
#TALKEY_VAD_MODEL=                   # full path to ggml-silero-v5.1.2.bin; talkey-setup vad
#TALKEY_WHISPER_LIB=                 # full path to libwhisper.so, if not found automatically
#TALKEY_VAD_THRESHOLD=0.5            # speech probability; higher rejects more background sound
#TALKEY_VAD_START_MS=160             # sustained speech needed to start a phrase
#TALKEY_VAD_SILENCE_MS=1200          # silence/mic mute needed to finish a phrase
# Optional semantic completion detection (talkey-setup turn). Silero still finds pauses.
#TALKEY_SMART_TURN=0                 # 1 = check whether speech sounds complete before typing
#TALKEY_AUTO_PYTHON=python3          # interpreter/venv with numpy + onnxruntime
#TALKEY_TURN_MODEL=                 # default ~/.local/share/talkey/models/smart-turn-v3.2-cpu.onnx
#TALKEY_TURN_THRESHOLD=0.9          # higher is more patient; completion probability
#TALKEY_TURN_MIN_SILENCE_MS=2000     # minimum pause even when completion is predicted
#TALKEY_TURN_MAX_SILENCE_MS=20000    # finish after this much silence even if incomplete
#TALKEY_END_PHRASE="message complete"    # opt-in spoken ending cue; empty disables it
#TALKEY_END_PHRASE_SILENCE_MS=600   # pause before checking a provisional transcript
#TALKEY_AUTO_IDLE_S=120            # switch auto mode off after this long without speech; 0 disables
#TALKEY_MAX_REC_S=900                 # hard cap on one RECORDING, so a stuck key can't run away.
                                      # Not a whisper limit - it transcribes any length.
                                      # Reaching it ends the recording but keeps the take.

# --- translate mode ----------------------------------------------------------
# `talkey translate toggle` speaks what you say in English, in your own voice,
# into a virtual microphone called "talkey English mic". Set up: talkey-setup translate
#TALKEY_TRANSLATE_ENGINE=whisper        # seamless = Meta's SeamlessStreaming, optional, set up with
                                        # talkey-setup seamless. Its weights are CC-BY-NC-4.0: non-commercial
                                        # use only; talkey does not ship them. See docs/translate.md
#TALKEY_SEAMLESS_HOME=                  # default ~/.local/share/talkey/seamless: its venv/ and models/
#TALKEY_SEAMLESS_PAUSE_WHISPER=0        # 1 = stop talkey-whisper.service while Seamless translates, for
                                        # its GPU memory; no dictation meanwhile
#TALKEY_TRANSLATE_PYTHON=python3        # venv with pocket-tts and CPU PyTorch
#TALKEY_TRANSLATE_VOICE=                # default ~/.local/share/talkey/translate/voice.safetensors
#TALKEY_TRANSLATE_FROM=nl               # language you speak; auto lets whisper guess per phrase
#TALKEY_TRANSLATE_NOTES=                # notes on the conversation; default ~/.config/talkey/translate-notes.txt
#TALKEY_TRANSLATE_LLM=translategemma:4b # Ollama model that translates
#TALKEY_TRANSLATE_GPU_LAYERS=           # e.g. 99 forces the whole model onto the GPU; unset lets Ollama decide
#TALKEY_TRANSLATE_URL=http://127.0.0.1:11434/api/chat
#TALKEY_TRANSLATE_TTS=english           # Pocket TTS model; english_2026-09_24l is larger and slower
#TALKEY_TRANSLATE_SPEED=0.95            # usual voice pace without changing pitch; below 1 is slower
#TALKEY_TRANSLATE_SPEED_MIN=0.85        # slowest pace, when no more English is coming soon
#TALKEY_TRANSLATE_SPEED_MAX=1.15        # fastest pace, when English is waiting
#TALKEY_TRANSLATE_GUARD=0.5             # English in hand before a piece starts, as a share of the usual wait; 0 = at once
#TALKEY_TRANSLATE_TEMP=                 # voice sampling temperature; unset uses Pocket's 0.3. Around 0.45
                                        # can sound more like you; at 1.0 words start to slur
#TALKEY_TRANSLATE_END_P=0.2             # model's chance that a sentence ends where you are, before it is spoken whole
#TALKEY_TRANSLATE_WORD_P=0.5            # below this, a word must agree in three transcripts, not two, before it is translated
#TALKEY_TRANSLATE_STREAM=1              # speak English the drafts agree on before you pause; 0 waits
#TALKEY_TRANSLATE_PREVIEW_MS=250        # how often the phrase so far is transcribed and translated
#TALKEY_TRANSLATE_TICK=1                # tick softly while a phrase waits for its next piece; 0 = silence
#TALKEY_TRANSLATE_RECORD=0              # 1 = keep each phrase's Dutch and English audio, to listen back
#TALKEY_TRANSLATE_SILENCE_MS=500        # pause that ends a phrase; shorter is faster but splits clauses
#TALKEY_TRANSLATE_QUICK_AFTER_S=4       # after this much speech in one phrase...
#TALKEY_TRANSLATE_QUICK_SILENCE_MS=250  # ...this shorter pause ends it
#TALKEY_TRANSLATE_MAX_S=15              # longest phrase; it is cut here even without a pause
#TALKEY_TRANSLATE_MONITOR=0             # 1 = also play the English on your own output (use headphones)
#TALKEY_TRANSLATE_TRACE=0               # 1 = log each phrase's timing to trace.jsonl in the run directory
#TALKEY_TRANSLATE_SINK=talkey_translate # other sink and mic names run a second, private instance, e.g. for tests
#TALKEY_TRANSLATE_MIC=talkey_translate_mic
#TALKEY_TRANSLATE_CAMERA=1              # start the talkey camera (v4l2loopback) with translation when it exists
#TALKEY_CAMERA_INPUT=                   # webcam to show; default the first real camera
#TALKEY_CAMERA_SIZE=1280x720            # size of the talkey camera; the webcam is scaled and cropped to it
#TALKEY_CAMERA_FPS=30

# --- typing ----------------------------------------------------------------
#TALKEY_COMMANDS=0                 # 1 = consume registered "command ..." phrases instead of typing
#TALKEY_COMMANDS_DIR=              # default ~/.config/talkey/commands.d; JSON definitions/overrides
#TALKEY_TYPE_DELAY=8                  # xdotool ms per character
#TALKEY_TYPE_MAX_MS=2000             # long messages type faster to finish within this; 0 = no cap
#TALKEY_TARGET_WINDOW=1               # 1 = lock output to the window focused at start
#TALKEY_PASTE=0                       # 1 = paste via clipboard instead of typing
#TALKEY_SUBMIT=0                      # 1 = press Enter automatically after typing

# --- live HUD --------------------------------------------------------------
#TALKEY_STREAM=1                      # 0 = no live transcription; keep state + meter
#TALKEY_STREAM_INTERVAL=0.3           # seconds between live transcribe passes
#TALKEY_HUD_MONITOR=                  # monitor name or index, e.g. DP-1 - unset = primary
#TALKEY_HUD_POS=                      # "<x>x<y>", e.g. 0x300
#TALKEY_HUD_SIZE=                     # "<w>x<h>", e.g. 680x220
#TALKEY_HUD_ANCHOR=                   # e.g. "top center"
#TALKEY_EWW_LINGER=2.5                # seconds the HUD stays after the text is typed
                                      # (not after you release - it waits out the
                                      # transcription, however slow the machine)
#TALKEY_STREAM_PROMPT=                # bias for the LIVE pump; empty on purpose - a long
                                      # prompt makes the incremental text lurch
#TALKEY_MAX_PUMP_S=60                 # pause the live PREVIEW once the buffer is longer
                                      # than this; each pass re-reads the whole buffer.
                                      # The final transcript stays complete regardless.
#TALKEY_LVL_FLOOR_DB=-45              # bottom of the level trace
#TALKEY_WARN_S=25                     # HUD flags a dictation longer than this
#TALKEY_HIST_N=70                     # level-trace history columns
#TALKEY_EWW_COLS=52                   # transcript wrap width, in characters
#TALKEY_EWW_LINES=4                   # transcript rows the HUD keeps visible
#TALKEY_SVG_W=600
#TALKEY_SVG_H=90

# --- level meter thresholds ------------------------------------------------
#TALKEY_PEAK_LOUD_DB=-10              # at/above = too loud (red)
#TALKEY_PEAK_LOW_DB=-20               # below = too low (orange); between = good (green)
#TALKEY_PEAK_CLIP_DB=-1               # talkey-mic-check: counts as clipping
#TALKEY_PEAK_FAINT_DB=-18             # talkey-mic-check: counts as faint
#TALKEY_CONF_WARN=70                  # confidence below this reads amber
#TALKEY_SIL_WARN=55                   # clip more than this percent silent reads amber
#TALKEY_QUIET_FLOOR=300               # RMS below this counts as a silent frame

# --- gestures --------------------------------------------------------------
#TALKEY_HOLD_MS=450                   # press longer than this = hold, shorter = toggle
#TALKEY_DOUBLE_TAP_MS=400             # double-tap: dictate = auto; submit = auto Enter; memo = restart

# --- vocabulary ------------------------------------------------------------
# Put your own words in ~/.config/talkey/vocabulary.txt and it is used instead of
# the shipped example (which is read-only, and replaced on upgrade).
#TALKEY_VOCAB_PROMPT=1                # 1 = bias short dictations with vocabulary.txt
#TALKEY_VOCAB_MAX_S=28                # only bias clips shorter than this
#TALKEY_PROMPT_FILE=                  # a vocabulary file somewhere else entirely

# --- recordings archive ----------------------------------------------------
#TALKEY_ARCHIVE=1                     # 0 = no persistent audio or transcript archive
#TALKEY_ARCHIVE_DIR=                  # default ~/.local/share/talkey/recordings
#TALKEY_CANCELLED_DIR=                # default $ARCHIVE_DIR/cancelled
# Naming recordings after what you said needs ollama AND a model pulled into it
# (ollama pull qwen2.5:3b). With no ollama running, recordings keep their
# timestamp name and nothing is sent. On by default - 0 turns it off.
#TALKEY_ARCHIVE_TITLE=1               # 1 = name recordings via a local Ollama model
#TALKEY_OLLAMA_URL=http://localhost:11434/api/generate
#TALKEY_OLLAMA_MODEL=qwen2.5:3b       # must be pulled; small and fast beats clever here
#TALKEY_OLLAMA_TIMEOUT=12

# --- sounds ----------------------------------------------------------------
#TALKEY_SOUNDS=1                      # 0 = silent
#TALKEY_SOUND_DIR=                    # your own start/stop/submit/cancel wavs
#TALKEY_MEMO_GAIN=2.0                 # memo playback volume boost

# --- key cheat sheet -------------------------------------------------------
# Labels only - these bind nothing. They name the keys printed on YOUR keyboard,
# so the cheat sheet and the HUD hints match what your fingers do. The defaults
# name the role instead ("dictate", "submit"), because no key legend is common
# to every keyboard.
#TALKEY_LABEL_DICTATE=dictate
#TALKEY_LABEL_DICTATE2=2nd language
#TALKEY_LABEL_SUBMIT=submit
#TALKEY_LABEL_MEMO=memo
#
# Keyboards with glyph keys can use them. A Keychron K10's media row, for
# instance, where the shapes are printed on the keycaps:
#TALKEY_LABEL_DICTATE=●
#TALKEY_LABEL_DICTATE2=Tools
#TALKEY_LABEL_SUBMIT=⏎ Triangle
#TALKEY_LABEL_MEMO=■ Square
# Language names default to the codes above, uppercased (en -> EN). Set these
# only if you want them spelled out.
#TALKEY_LABEL_LANG=English
#TALKEY_LABEL_LANG2=

# --- key bindings without a window manager ---------------------------------
# Only needed if you start talkey-norepeat as a user service: a service has no
# argument list, so it reads the keycodes from here. Same numbers your bindings
# use. Leave unset if your WM passes them on the command line (i3 does).
#TALKEY_NOREPEAT_KEYCODES=194 191 193 192

# --- external tools --------------------------------------------------------
#TALKEY_FFMPEG=ffmpeg
#TALKEY_XDOTOOL=xdotool
#TALKEY_XCLIP=xclip
#TALKEY_PLAYER=paplay
#TALKEY_EWW=eww

# --- paths -----------------------------------------------------------------
#TALKEY_DATA_DIR=                     # sounds/vocabulary/HUD root; probed by default
#TALKEY_STATE_DIR=                    # default $XDG_RUNTIME_DIR/talkey
# TALKEY_CONFIG points at THIS file. It can only be set in the environment -
# naming it here would be circular. Default ~/.config/talkey/talkey.env.

# --- debugging -------------------------------------------------------------
#TALKEY_STREAM_DEBUG=0                # 1 = per-pass numbers from the live pump

# Set by talkey itself, not by you: TALKEY_EWW_DIR, TALKEY_DIAG, TALKEY_PROMPT.
