#!/usr/bin/env bash
# talkey-hud - the voice HUD's renderer adapter. Shows the eww HUD whenever a
# dictation is active by keying off the recorder pidfile that bin/talkey writes
# ($STATE_DIR/dictate.pid) via inotify - event-driven, no polling, and talkey itself
# stays renderer-agnostic (it only writes the state files this HUD reads). i3
# starts it via exec_always (see talkey/i3/talkey.conf); it is
# single-instance, so reloads never stack a second watcher.
#
#   talkey-hud            # start the daemon + watch
#   talkey-hud stop       # close the HUD + kill the eww daemon
set -u

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# Finds the data root, loads ~/.config/talkey/talkey.env, sets STATE_DIR. In a
# checkout this script lives in integrations/eww, so the probe looks two levels
# up as well as one.
for _l in "$SCRIPT_DIR/../../lib" "$SCRIPT_DIR/../lib" /usr/share/talkey/lib; do
  [[ -f "$_l/common.sh" ]] && { . "$_l/common.sh"; break; }
done
[[ -n "${DATA_DIR:-}" ]] || { echo "talkey-hud: cannot find lib/common.sh" >&2; exit 1; }

CFG="$DATA_DIR/integrations/eww"
[[ -f "$CFG/eww.yuck" ]] || { echo "talkey-hud: no eww config at $CFG - set TALKEY_DATA_DIR" >&2; exit 1; }
PIDFILE="$STATE_DIR/dictate.pid"
EWW="${TALKEY_EWW:-eww}"
LINGER="${TALKEY_EWW_LINGER:-2.5}"       # seconds the HUD stays after recording ends

# Where the HUD appears. eww.yuck holds the defaults; anything set here is passed
# to `eww open` and wins, so placement is config, not a file you have to edit.
# HUD_MONITOR is the one you are most likely to need - unset means eww's default
# (your primary display), which is wrong if you dictate on a secondary one.
HUD_MONITOR="${TALKEY_HUD_MONITOR:-}"    # monitor name or index, e.g. "DP-1" or "1"
HUD_POS="${TALKEY_HUD_POS:-}"            # "<x>x<y>", e.g. "0x300"
HUD_SIZE="${TALKEY_HUD_SIZE:-}"          # "<w>x<h>", e.g. "680x220"
HUD_ANCHOR="${TALKEY_HUD_ANCHOR:-}"      # e.g. "top center"

open_args=()
[[ -n "$HUD_MONITOR" ]] && open_args+=(--screen "$HUD_MONITOR")
[[ -n "$HUD_POS" ]]     && open_args+=(--pos "$HUD_POS")
[[ -n "$HUD_SIZE" ]]    && open_args+=(--size "$HUD_SIZE")
[[ -n "$HUD_ANCHOR" ]]  && open_args+=(--anchor "$HUD_ANCHOR")

# eww runs the deflisten command through a shell but doesn't hand it the config
# dir, so export it here - the daemon (and thus eww-feed) inherit it. Portable:
# derived from this script's own location, no hardcoded path.
export TALKEY_EWW_DIR="$CFG"

command -v "$EWW" >/dev/null 2>&1 || { echo "eww not installed (pacman -S eww, or AUR eww-git)"; exit 1; }

# 9>&- matters: `eww daemon` forks and outlives this script, and without closing
# the fd it would inherit our single-instance lock and hold it forever. Kill this
# watcher and every later one then reports "already running" and exits - the HUD
# never comes back until you kill eww by hand.
ew()   { "$EWW" -c "$CFG" "$@" >/dev/null 2>&1 9>&- || true; }
open_hud()  { ew open talkeyhud ${open_args[@]+"${open_args[@]}"}; }
close_hud() { ew close talkeyhud; }

if [[ "${1:-}" == stop ]]; then close_hud; ew kill; exit 0; fi

command -v inotifywait >/dev/null 2>&1 || { echo "need inotify-tools"; exit 1; }
mkdir -p "$STATE_DIR"

# Single-instance: i3 runs this via exec_always, which fires on every reload.
# Hold a lock so a second instance exits at once instead of stacking a second
# inotifywait (and re-killing the daemon). First instance keeps fd 9 open for life.
exec 9>"$STATE_DIR/talkey-hud.lock" 2>/dev/null || true
if command -v flock >/dev/null 2>&1; then
  flock -n 9 || { echo "talkey-hud already running"; exit 0; }
fi

# Restart the daemon so it picks up TALKEY_EWW_DIR (a stale daemon started without
# it can't resolve eww-feed). Kill is a no-op if none is running.
ew kill; sleep 0.3; ew daemon; sleep 0.4
[[ -f "$PIDFILE" ]] && open_hud

# Monitor the state dir; react only to the recorder pidfile. Create/appear -> show
# now; delete/vanish -> show for a linger then close (unless a new dictation began).
#
# Same two guards as ew(): 9>&- so this long-lived child never inherits the
# single-instance lock, and a trap so it dies with us instead of being reparented
# to init and watching the state dir forever.
exec 8< <(inotifywait -m -e create -e delete -e moved_to -e moved_from \
           --format '%e %f' "$STATE_DIR" 2>/dev/null 9>&-)
WATCH_PID=$!
trap 'kill "$WATCH_PID" 2>/dev/null' EXIT INT TERM

while read -r _ev fname <&8; do
  [[ "$fname" == "dictate.pid" ]] || continue
  if [[ -f "$PIDFILE" ]]; then
    open_hud
  else
    ( sleep "$LINGER"; [[ -f "$PIDFILE" ]] || close_hud ) &
  fi
done
