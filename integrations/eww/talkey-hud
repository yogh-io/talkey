#!/usr/bin/env bash
# talkey-hud - the voice HUD's renderer adapter. Shows the eww HUD whenever a
# dictation is active by keying off the recorder pidfile that bin/talkey writes
# ($STATE_DIR/dictate.pid) via inotify - event-driven, no polling, and talkey itself
# stays renderer-agnostic (it only writes the state files this HUD reads). i3
# starts it via exec_always (see bindings/i3.conf); it is
# single-instance, so reloads never stack a second watcher.
#
#   talkey-hud            # start the daemon + watch
#   talkey-hud stop       # close the HUD + kill the eww daemon
set -u

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# Finds the data root, loads ~/.config/talkey/talkey.env, sets STATE_DIR. In a
# checkout this script lives in integrations/eww, so the probe looks two levels
# up as well as one.
for _l in "${TALKEY_DATA_DIR:-/nonexistent}/lib" "$SCRIPT_DIR/../../lib" "$SCRIPT_DIR/../lib" /usr/share/talkey/lib; do
  [[ -f "$_l/common.sh" ]] && { . "$_l/common.sh" || exit 1; break; }
done
[[ -n "${DATA_DIR:-}" ]] || { echo "talkey-hud: cannot find lib/common.sh" >&2; exit 1; }

CFG="$DATA_DIR/integrations/eww"
[[ -f "$CFG/eww.yuck" ]] || { echo "talkey-hud: no eww config at $CFG - set TALKEY_DATA_DIR" >&2; exit 1; }
PIDFILE="$STATE_DIR/dictate.pid"
PENDING="$STATE_DIR/dictate.pending"     # talkey holds this while it is still transcribing
ALERT="$STATE_DIR/dictate.alert"         # talkey refused before recording; show why
HELP_ON="$STATE_DIR/help.on"             # `talkey help` toggles this; we draw the sheet
EWW="${TALKEY_EWW:-eww}"
LINGER="${TALKEY_EWW_LINGER:-2.5}"       # seconds the HUD stays after the dictation ends
ERR_LINGER="${TALKEY_EWW_ERR_LINGER:-8}" # longer for an error: it names a command to run

# Where the HUD appears. eww.yuck holds the defaults; anything set here is passed
# to `eww open` and wins, so placement is config, not a file you have to edit.
# HUD_MONITOR is the one you are most likely to need - unset means eww's default
# (your primary display), which is wrong if you dictate on a secondary one.
HUD_MONITOR="${TALKEY_HUD_MONITOR:-}"    # monitor name or index, e.g. "DP-1" or "1"
HUD_POS="${TALKEY_HUD_POS:-}"            # "<x>x<y>", e.g. "0x300"
HUD_SIZE="${TALKEY_HUD_SIZE:-}"          # "<w>x<h>", e.g. "680x220"
HUD_ANCHOR="${TALKEY_HUD_ANCHOR:-}"      # e.g. "top center"

open_args=()
[[ -n "$HUD_MONITOR" ]] && open_args+=(--screen "$HUD_MONITOR")
[[ -n "$HUD_POS" ]]     && open_args+=(--pos "$HUD_POS")
[[ -n "$HUD_ANCHOR" ]]  && open_args+=(--anchor "$HUD_ANCHOR")
# The translate window goes in the same place, at its own size.
place_args=(${open_args[@]+"${open_args[@]}"})
[[ -n "$HUD_SIZE" ]]    && open_args+=(--size "$HUD_SIZE")

# eww runs the deflisten command through a shell but doesn't hand it the config
# dir, so export it here - the daemon (and thus eww-feed) inherit it. Portable:
# derived from this script's own location, no hardcoded path.
export TALKEY_EWW_DIR="$CFG"

command -v "$EWW" >/dev/null 2>&1 || { echo "eww not installed (AUR: eww)" >&2; exit 1; }

HUD_LOG="$STATE_DIR/hud.log"

# 9>&- matters: `eww daemon` forks and outlives this script, and without closing
# the fd it would inherit our single-instance lock and hold it forever. Kill this
# watcher and every later one then reports "already running" and exits - the HUD
# never comes back until you kill eww by hand.
#
# Failures are recorded, not swallowed. A HUD that never appears used to leave
# nothing behind to explain why: the window is not focusable and nobody is
# watching this process's output.
# Output goes to a FILE, never a pipe: `eww daemon` forks and keeps its stdout
# open, so capturing it in a command substitution would wait for an EOF that
# never comes and hang this watcher before it ever starts watching.
#
# Only failures reach the log. eww narrates every window it opens at INFO level,
# and a log that records success too is one nobody reads when something breaks.
ew() {
  local status=0 tmp
  tmp="$(mktemp "$STATE_DIR/eww-out.XXXXXX")" || tmp=/dev/null
  { "$EWW" -c "$CFG" "$@" 9>&-; } >"$tmp" 2>&1 || status=$?
  if (( status )); then
    { printf '%s eww %s -> exit %d\n' "$(date +%H:%M:%S)" "$*" "$status"
      [[ "$tmp" != /dev/null ]] && cat "$tmp"; } >> "$HUD_LOG"
  fi
  [[ "$tmp" != /dev/null ]] && rm -f "$tmp"
  return "$status"
}
# `eww kill` with no daemon running is a normal outcome, not a fault.
ew_optional() { "$EWW" -c "$CFG" "$@" >/dev/null 2>&1 9>&- || true; }
# `eww open` on a window that is already open closes and reopens it, and every
# state change of a take lands here - so open only when it is not up yet, or the
# HUD flickers at the start and end of each dictation.
is_open() { "$EWW" -c "$CFG" active-windows 2>/dev/null 9>&- | grep -q "^$1:"; }
open_hud()  { is_open talkeyhud || ew open talkeyhud ${open_args[@]+"${open_args[@]}"}; }
# A new translate window starts at the newest phrase, not where the last one was scrolled to.
open_translate() {
  is_open talkeytranslate && return
  rm -f "$STATE_DIR/translate.scroll"
  ew open talkeytranslate ${place_args[@]+"${place_args[@]}"}
}
# Closing a window that is already closed is a NORMAL outcome here, not a fault:
# the recorder pidfile and the pending marker each schedule a close when they go
# away, and the alert path runs a third on its own timer, so on a plain dictation
# one of them always arrives to find nothing left to close. It goes through
# ew_optional, like `eww kill` with no daemon - logging it filled hud.log with
# hundreds of lines about healthy dictations, which then read as "the HUD has
# logged problems" in talkey doctor. Nothing is hidden by staying quiet: a close
# that really fails leaves an always-on-top window sitting on your screen.
close_hud() { ew_optional close talkeyhud; }
close_translate() { ew_optional close talkeytranslate; }

# Recording stopping is NOT the dictation ending. The final text, the done state
# and the confidence/silence/peak reading are all written after the recorder is
# gone - on a CPU-only machine that transcription takes tens of seconds, far
# longer than LINGER. So the HUD closes on talkey's pending marker, not on the
# recorder pidfile: whichever of the two goes away last starts the linger.
# A dictation or an alert shows in the HUD. Live translation hearing, translating
# or speaking a phrase shows in its own window in the same place; while the HUD
# is needed, the HUD replaces it.
want_hud() { [[ -f "$PIDFILE" || -f "$PENDING" || -f "$ALERT" ]]; }
want_translate() { [[ -f "$STATE_DIR/translate.showing" ]] && ! want_hud; }
refresh() {
  if want_hud; then
    close_translate; open_hud
  elif want_translate; then
    close_hud; open_translate
  else
    ( sleep "$LINGER"; want_hud || close_hud; want_translate || close_translate ) &
  fi
}

# The cheat sheet. The labels name the keys printed on YOUR keyboard - talkey
# binds nothing by them, they are only what the sheet says. Pushed into eww as
# one JSON value so the widget stays a dumb renderer.
help_json() {
  # Language names are DERIVED from the codes you dictate in - "en" reads as EN,
  # "nl" as NL - so no language is baked in as the assumed one. Override with
  # TALKEY_LABEL_LANG / _LANG2 if you would rather see languages spelled out.
  local l1 l2
  l1="${TALKEY_LABEL_LANG:-$(printf '%s' "${TALKEY_LANG:-en}" | tr '[:lower:]' '[:upper:]')}"
  if [[ -n "${TALKEY_LABEL_LANG2:-}" ]]; then
    l2="$TALKEY_LABEL_LANG2"
  elif [[ -n "${TALKEY_LANG2:-}" ]]; then
    l2="$(printf '%s' "$TALKEY_LANG2" | tr '[:lower:]' '[:upper:]')"
  else
    l2=""      # no second language configured - the sheet drops that row
  fi
  # The defaults name the ROLE, not a key. Most keyboards have no circle, square
  # or triangle to point at, so claiming one would be wrong for nearly everyone.
  # Set TALKEY_LABEL_* to whatever is printed on the keys you actually bound.
  jq -nc --arg d "${TALKEY_LABEL_DICTATE:-dictate}" \
    --arg d2 "${TALKEY_LABEL_DICTATE2:-2nd language}" \
    --arg s "${TALKEY_LABEL_SUBMIT:-submit}" --arg m "${TALKEY_LABEL_MEMO:-memo}" \
    --arg l "$l1" --arg l2 "$l2" \
    '{dictate:$d,dictate2:$d2,submit:$s,memo:$m,lang:$l,lang2:$l2}'
}
open_help()  { ew update "help=$(help_json)"; ew open talkeyhelp ${open_args[@]+"${open_args[@]}"}; }
close_help() { ew close talkeyhelp; }

if [[ "${1:-}" == stop ]]; then close_hud; close_translate; ew_optional close talkeyhelp; ew_optional kill; exit 0; fi

command -v inotifywait >/dev/null 2>&1 || { echo "need inotify-tools"; exit 1; }
mkdir -p "$STATE_DIR"

# Single-instance: i3 runs this via exec_always, which fires on every reload.
# Hold a lock so a second instance exits at once instead of stacking a second
# inotifywait (and re-killing the daemon). First instance keeps fd 9 open for life.
exec 9>"$STATE_DIR/talkey-hud.lock" 2>/dev/null || true
if command -v flock >/dev/null 2>&1; then
  flock -n 9 || { echo "talkey-hud already running"; exit 0; }
fi

# Restart the daemon so it picks up TALKEY_EWW_DIR (a stale daemon started without
# it can't resolve eww-feed). Kill is a no-op if none is running.
ew_optional kill; sleep 0.3; ew daemon || echo "talkey-hud: eww daemon failed to start - see $HUD_LOG" >&2
sleep 0.4
if want_hud || want_translate; then refresh; fi
[[ -f "$HELP_ON" ]] && open_help

# Monitor the state dir. The recorder pidfile appearing -> show now. The pidfile
# and the pending marker both gone -> show for a linger, then close (unless a new
# dictation began in the meantime).
#
# Same two guards as ew(): 9>&- so this long-lived child never inherits the
# single-instance lock, and a trap so it dies with us instead of being reparented
# to init and watching the state dir forever.
exec 8< <(inotifywait -q -m -e create -e delete -e moved_to -e moved_from -e modify \
           --format '%e %f' "$STATE_DIR" 2>>"$HUD_LOG" 9>&-)
WATCH_PID=$!
trap 'kill "$WATCH_PID" 2>/dev/null || true' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

while read -r _ev fname <&8; do
  case "$fname" in
    session.changed|dictate.pid|translate.showing)
      refresh ;;
    dictate.pending)
      # Only the marker going away matters here - it appears while the recorder
      # pidfile is still there, and that is what opened the HUD.
      [[ -f "$PENDING" ]] || refresh ;;
    dictate.alert)
      # talkey refused before recording - there is no pidfile to open the window,
      # and a message nobody can see is the same as no message. Held longer than
      # a normal dictation: this one names a command to go and run, and two lines
      # cannot be read in the time a finished dictation lingers.
      if [[ -f "$ALERT" ]]; then
        refresh
        ( sleep "$ERR_LINGER"; rm -f "$ALERT"
          want_hud || close_hud ) &
      else
        refresh
      fi ;;
    help.on)
      if [[ -f "$HELP_ON" ]]; then open_help; else close_help; fi ;;
  esac
done

# Falling out of that loop means the watch died. Say so and exit non-zero, so a
# service restarts us instead of leaving a dictation with no HUD and no reason.
echo "talkey-hud: the state watch ended unexpectedly - see $HUD_LOG" >&2
printf '%s watch ended unexpectedly\n' "$(date +%H:%M:%S)" >> "$HUD_LOG"
exit 1
