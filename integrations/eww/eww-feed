#!/usr/bin/env bash
# eww-feed - stream the live talkey state as one JSON line per tick, for the
# experimental eww HUD. Pure parallel renderer: reads the SAME files bin/talkey writes
# ($STATE_DIR/dictate.{header,transcript,footer,metrics,raw}); changes nothing.
#
# It computes the display strings here (footer hint, metrics line, elapsed time)
# so the widget stays a dumb renderer. Fields:
#   header       state token (listening/transcribing/done/cancelled/nospeech)
#   transcript   full text (widget shows all of it)
#   timetext     "Ns" or "Ns ⚠ long"          long   long-dictation flag
#   footertext   the hotkey-hint line          footerkind  send|cancel|plain
#   metricstext  final "conf.. silence.. peak.." (empty until done)  pzone good|loud|low
#   level,zone   live meter (0..100 + zone of the last ~0.13s)
set -u

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
for _l in "${TALKEY_DATA_DIR:-/nonexistent}/lib" "$SCRIPT_DIR/../../lib" "$SCRIPT_DIR/../lib" /usr/share/talkey/lib; do
  [[ -f "$_l/common.sh" ]] && { . "$_l/common.sh" || exit 1; break; }
done
# Without this the failure is an unbound-variable death inside the eww daemon,
# where nobody ever sees it.
[[ -n "${DATA_DIR:-}" ]] || { echo "eww-feed: cannot find lib/common.sh" >&2; exit 1; }
# Same reasoning: without jq every tick would emit nothing and the HUD would sit
# there blank, looking like talkey never heard you.
command -v jq >/dev/null 2>&1 || { echo "eww-feed: jq is required for the HUD" >&2; exit 1; }
RAW="$STATE_DIR/dictate.raw"; TR="$STATE_DIR/dictate.transcript"
HD="$STATE_DIR/dictate.header"; FT="$STATE_DIR/dictate.footer"; MET="$STATE_DIR/dictate.metrics"
SUBS="$STATE_DIR/translate.subtitles"

# The hints name keys, so they follow the same labels as the cheat sheet - a
# hardcoded "Square" tells most people to press a key they do not have.
L_SUBMIT="${TALKEY_LABEL_SUBMIT:-submit}"
L_MEMO="${TALKEY_LABEL_MEMO:-memo}"

LOUD="${TALKEY_PEAK_LOUD_DB:--10}"; LOW="${TALKEY_PEAK_LOW_DB:--20}"
FLOOR="${TALKEY_LVL_FLOOR_DB:--45}"; WARN_S="${TALKEY_WARN_S:-25}"

. "$DATA_DIR/lib/session.sh"
. "$DATA_DIR/lib/hud.sh"

# Sample while a recorder is alive; otherwise wait for controller state events.
while :; do
  emit
  if process_alive "$STATE_DIR/dictate.pid"; then
    sleep 0.1
  else
    inotifywait -qq -t 30 -e create -e modify -e delete -e moved_to "$STATE_DIR" 2>/dev/null || true
  fi
done
