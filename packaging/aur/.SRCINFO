pkgbase = talkey-git
	pkgdesc = Push-to-talk voice input for X11/i3 - hold a key, speak, the text is typed. Offline, no API key.
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/yogh-io/talkey
	install = talkey-git.install
	arch = any
	license = MIT
	makedepends = git
	depends = bash
	depends = whisper-cpp
	depends = ffmpeg
	depends = xdotool
	depends = xorg-xset
	depends = libpulse
	depends = curl
	depends = python
	optdepends = whisper.cpp-model-large-v3-turbo: the default speech model (AUR) - talkey needs some model
	optdepends = whisper.cpp-model-small: translate-to-English support (AUR)
	optdepends = eww: the live dictation HUD and the key cheat sheet (AUR)
	optdepends = inotify-tools: the live dictation HUD
	optdepends = jq: the live dictation HUD, the confidence readout, and titles for archived recordings
	optdepends = libnotify: desktop notifications - the only feedback when the HUD is not installed
	optdepends = ollama: auto-titled recordings in the archive
	optdepends = xclip: paste mode (TALKEY_PASTE=1) instead of typing
	optdepends = sxhkd: key bindings without i3
	optdepends = xbindkeys: key bindings without i3
	provides = talkey
	conflicts = talkey
	source = talkey-git::git+https://github.com/yogh-io/talkey.git
	sha256sums = SKIP

pkgname = talkey-git
