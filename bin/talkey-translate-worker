#!/usr/bin/env python3
"""Live translation into a virtual microphone, spoken in your cloned voice.

Capture, Silero VAD and endpoints match auto mode. An engine turns each phrase into English
while it is spoken: whisper and TranslateGemma (lib/whisper_engine.py, the default) or
SeamlessStreaming (lib/seamless.py). Phrases are spoken in order, each as one continuous utterance.
"""
import argparse
from collections import deque
from concurrent.futures import ThreadPoolExecutor
import importlib.util
import json
import math
import os
from pathlib import Path
import queue
import signal
import statistics
import subprocess
import sys
import threading
import time
import wave

for data in (Path(os.environ.get('TALKEY_DATA_DIR', '/nonexistent')),
             Path(__file__).resolve().parent.parent, Path('/usr/share/talkey')):
    if (data / 'lib/speech.py').is_file():
        sys.path.insert(0, str(data / 'lib'))
        DATA_DIR = data
        break
from seamless import SeamlessEngine
from vad import FRAME_BYTES, FRAME_MS, Endpoint, Silero, setting
from whisper_engine import WhisperEngine

# While a phrase waits for its next piece, a tick after this much quiet, then every so often.
TICK_AFTER_S = 0.3
TICK_EVERY_S = 0.5
# Phrases the HUD can scroll back through.
HISTORY = 100
# The voice's pace stays between these shares of its usual pace: slower while no more English is
# coming soon, faster while English waits behind the piece being said.
SLOWEST, FASTEST = 0.9, 1.2
# Settled English waits while the English in hand would not last this share of the usual wait for the next piece.
GUARD = 0.5
# In a phrase longer than this, a shorter pause ends it, so a monologue still flows out.
QUICK_AFTER_MS, QUICK_SILENCE_MS = 4000, 250


def wait_sound(rate):
    """The tick that tells listeners a phrase is still coming, as PCM; None when switched off."""
    if os.environ.get('TALKEY_TRANSLATE_TICK', '1') != '1':
        return None
    path = Path(os.environ.get('TALKEY_SOUND_DIR', DATA_DIR / 'sounds')) / 'translate-tick.wav'
    with wave.open(str(path)) as sound:
        if (sound.getnchannels(), sound.getsampwidth(), sound.getframerate()) != (1, 2, rate):
            raise ValueError(f'{path} must be 16-bit mono at {rate} Hz, the rate of the voice')
        pcm = sound.readframes(sound.getnframes())
    # Without silence after it, the player would wait for more audio before playing the tick.
    return pcm + bytes(2 * int(rate * 0.1))


def default_voice():
    data = Path(os.environ.get('XDG_DATA_HOME', Path.home() / '.local/share'))
    return os.environ.get('TALKEY_TRANSLATE_VOICE', str(data / 'talkey/translate/voice.safetensors'))


class StopRequested(Exception):
    pass


def stop_requested(*_):
    raise StopRequested()


class Phrases(Endpoint):
    """Long phrases end on a shorter pause, so a monologue still flows out."""
    def __init__(self, start_ms, silence_ms, max_ms, quick_ms, quick_after_ms):
        super().__init__(start_ms, silence_ms, max_ms)
        self.quick_frames = math.ceil(quick_ms / FRAME_MS)
        self.quick_after = math.ceil(quick_after_ms / FRAME_MS)

    def update(self, speech):
        event = super().update(speech)
        if (event is None and self.active and self.length - self.quiet >= self.quick_after
                and self.quiet >= self.quick_frames):
            self.reset()
            return 'end'
        return event


class Trace:
    """With TALKEY_TRANSLATE_TRACE=1, each phrase's events as JSON lines, timed from its first word.

    Times come from the audio clock: frame k of the capture is mapped to the earliest monotonic
    time it could have arrived, so a busy main loop does not shift them.
    """
    def __init__(self, path):
        self.file = path.open('a', buffering=1) if path else None
        self.lock = threading.Lock()
        self.origin = math.inf
        self.frames = self.voiced = 0

    def frame(self, speech):
        if self.file:
            self.frames += 1
            self.origin = min(self.origin, time.monotonic() - self.frames * FRAME_MS / 1000)
            if speech:
                self.voiced = self.frames

    def clock(self, frames):
        """Monotonic time at which the capture reached this many frames."""
        return self.origin + frames * FRAME_MS / 1000

    # Fields holding a monotonic time, written like t: seconds since the phrase's first word.
    TIMES = ('start', 'end', 'audio_from', 'heard_to', 'detected', 'endpoint')

    def __call__(self, phrase, event, at=None, **fields):
        if not self.file:
            return
        at = time.monotonic() if at is None else at
        line = {'n': phrase.number, 'event': event, 't': round(at - phrase.onset, 3), 'at': round(at, 3)}
        for key, value in fields.items():
            line[key] = round(value - phrase.onset, 3) if key in Trace.TIMES and value is not None else value
        with self.lock:
            self.file.write(json.dumps(line, ensure_ascii=False) + '\n')


class Phrase:
    """One stretch of speech, from its first word to the pause after it."""
    def __init__(self, started, number):
        self.started, self.ended, self.number = started, None, number
        # When the first word began, by the audio clock; the VAD notices it a little later.
        self.onset = started
        self.audio_from = started
        self.audio = b''
        self.frames = []
        # As the HUD shows it; each piece of English gets the Unix times it starts and stops playing.
        self.shown = {'n': number, 'dutch': '', 'english': '', 'live': True, 'done': False, 'pieces': []}
        # Held while a preview or the final translation works on this phrase.
        self.lock = threading.Lock()
        self.closed = False
        self.agreement = None
        # The conversation context while this phrase is heard, so its prompt stays the same.
        self.context = ''
        # The bare words of the latest previews, and the latest draft with what it was made from.
        self.heard = deque(maxlen=2)
        self.drafted = None
        self.english = ''
        # (piece, last piece of the phrase, joins the last word, ends a sentence) to speak, then None.
        self.segments = queue.Queue()
        # Pieces queued and not yet taken by the voice; when the last piece was handed over and
        # when the latest preview started, for the session's timing.
        self.waiting = 0
        self.committed_at = None
        self.previewed_at = None


ENGINES = {'whisper': WhisperEngine, 'seamless': SeamlessEngine}


class Voice:
    """Pocket TTS on CPU, streamed as 16-bit mono PCM; a phrase spoken in pieces stays one utterance.

    A piece after the first is generated with the previous piece's text and its generated frames
    forced in front, so it carries on instead of starting a new sentence. A piece that is not
    the last loses its end-of-speech tail, which would otherwise sound like a sentence ending.
    The pace changes without changing the pitch: pace() is asked before each chunk.
    """
    TAIL_FRAMES = 3
    # Leading silence below this level is skipped, keeping a little before the voice begins.
    QUIET = 0.01
    ONSET_S = 0.04

    def __init__(self, path):
        import inspect
        import torch
        from pocket_tts import TTSModel
        from pocket_tts.models.text_chunking import prepare_text_prompt, split_into_best_sentences
        from stretch import Stretch
        self.torch, self.prepare, self.split = torch, prepare_text_prompt, split_into_best_sentences
        if 'forced_latents' not in inspect.signature(TTSModel._generate_audio_stream_short_text).parameters:
            raise ValueError('this Pocket TTS cannot continue an utterance; run: talkey-setup translate')
        # Unset keeps Pocket TTS's own default. Higher can sound more like the voice sample.
        temp = os.environ.get('TALKEY_TRANSLATE_TEMP')
        options = {'temp': float(temp)} if temp else {}
        self.model = TTSModel.load_model(language=os.environ.get('TALKEY_TRANSLATE_TTS', 'english'), **options)
        self.state = self.model.get_state_for_audio_prompt(path)
        self.sample_rate = self.model.sample_rate
        self.frame_samples = round(self.sample_rate / self.model.mimi.frame_rate)
        speed = setting('TRANSLATE_SPEED', '0.95', 0.5, 1.5)
        self.stretch = Stretch(speed, self.sample_rate)
        self.pace = lambda: speed
        # Seconds of voice per character at its own pace, over the latest pieces.
        self.rates = deque(maxlen=20)
        self.previous = None

    def seconds(self, text):
        """How long text takes to say at the voice's own pace, from the pieces it has said."""
        return len(text) * statistics.fmean(self.rates)

    def stream(self, text, last=True, joined=False):
        """PCM for one piece of the current phrase; last ends the utterance, joined continues the last word."""
        m = self.model
        chunks = self.split(m.flow_lm.conditioner.tokenizer, text, 25, m.pad_with_spaces_for_short_inputs,
                            remove_semicolons=m.remove_semicolons, append_terminal_punctuation=False,
                            capitalize_first_letter=False, replace_characters=m.replace_characters)
        for i, chunk in enumerate(chunks):
            yield from self.piece(chunk, last and i == len(chunks) - 1, joined and i == 0)

    def piece(self, text, last, joined=False):
        m, tail = self.model, self.TAIL_FRAMES * self.frame_samples * 2
        context, forced = text, None
        if self.previous:
            context, forced = self.previous[0] + ('' if joined else ' ') + text, self.previous[1]
        options = (m.pad_with_spaces_for_short_inputs, m.remove_semicolons, last,
                   m.capitalize_first_letter, m.replace_characters)
        prompt, _ = self.prepare(context, *options)
        _, after = self.prepare(text, *options)
        latents, held, onset, made = [], b'', forced is None, 0
        for chunk in m._generate_audio_stream_short_text(self.state, prompt, after + 2, True,
                                                         threading.Event(), latents_out=latents,
                                                         forced_latents=forced):
            if onset:
                loud = (chunk.abs() > self.QUIET).nonzero()
                if not len(loud):
                    continue
                chunk, onset = chunk[max(0, int(loud[0]) - int(self.ONSET_S * self.sample_rate)):], False
            held += (chunk.clamp(-1, 1) * 32767).to(self.torch.int16).numpy().tobytes()
            # The tail is only known to be unwanted once the piece turns out not to be the last.
            ready = len(held) if last else len(held) - tail
            if ready > 0:
                self.stretch.speed = self.pace()
                if pcm := self.stretch.push(held[:ready]):
                    yield pcm
                made += ready
                held = held[ready:]
        if pcm := self.stretch.flush():
            yield pcm
        if made and text.strip():
            self.rates.append(made / 2 / self.sample_rate / len(text))
        frames = self.torch.cat(latents, 1) if latents else None
        if last or frames is None or frames.shape[1] <= self.TAIL_FRAMES + 4:
            self.previous = None
        else:
            self.previous = (text, frames[:, :-self.TAIL_FRAMES])

    def end(self):
        """The phrase is over; the next piece starts a new utterance."""
        self.previous = None


class Interpreter:
    def __init__(self, vad, voice_path, engine):
        self.vad, self.voice_path = vad, voice_path
        self.voice = None
        self.run_dir = Path(os.environ['TALKEY_TRANSLATE_RUN'])
        self.state_dir = Path(os.environ['TALKEY_STATE_DIR'])
        self.command = str(Path(__file__).resolve().with_name('talkey'))
        self.language = os.environ.get('TALKEY_TRANSLATE_FROM', 'nl')
        start = setting('VAD_START_MS', '160', 32, 2000)
        silence = setting('TRANSLATE_SILENCE_MS', '500', 160, 10000)
        cap = setting('TRANSLATE_MAX_S', '15', 1, 600)
        self.endpoint = Phrases(start, silence, cap * 1000, QUICK_SILENCE_MS, QUICK_AFTER_MS)
        self.preroll = deque(maxlen=math.ceil((start + 300) / FRAME_MS))
        self.frames = queue.Queue(maxsize=math.ceil(120000 / FRAME_MS))
        self.lines = queue.Queue()
        self.speed = setting('TRANSLATE_SPEED', '0.95', 0.5, 1.5)
        self.speed_min, self.speed_max = self.speed * SLOWEST, self.speed * FASTEST
        # Measured as the session goes: seconds from a piece being handed to the voice until the
        # next one is settled (starting from a guess), the voice's time to its first audio, and the
        # time between the engine's looks at a phrase.
        self.refill = deque([1.0], maxlen=20)
        self.first_audio = deque(maxlen=20)
        self.cycle = deque(maxlen=20)
        # The phrase and piece the voice is saying, and the seconds of English it had in hand then.
        self.speaking = None
        # Whether the last piece played ended a sentence; a tick only fills a wait inside one.
        self.ended = True
        # When the English already sent to the players will have finished playing.
        self.voice_end = 0.0
        self.tick_sound = None
        self.next_tick = 0.0
        # When everything sent to the players, ticks included, has finished playing.
        self.played_end = 0.0
        self.count = 0
        self.recordings = None
        if os.environ.get('TALKEY_TRANSLATE_RECORD', '0') == '1':
            archive = Path(os.environ.get('TALKEY_ARCHIVE_DIR', Path.home() / '.local/share/talkey/recordings'))
            self.recordings = archive / 'translate' / time.strftime('%Y%m%d-%H%M%S')
            self.recordings.mkdir(mode=0o700, parents=True, exist_ok=True)
        tracing = os.environ.get('TALKEY_TRANSLATE_TRACE', '0') == '1'
        self.trace = Trace(self.run_dir / 'trace.jsonl' if tracing else None)
        # The session's recent phrases, as the HUD shows them. The lock also guards the counts.
        self.subtitles = deque(maxlen=HISTORY)
        self.lock = threading.Lock()
        self.hearing = False
        self.inflight = 0
        self.showing = False
        self.error = None
        self.capture = None
        self.players = []
        self.stopping = threading.Event()
        self.engine = engine(self) if engine else None

    def state(self, value):
        if (self.run_dir / 'state').read_text().strip() == 'off':
            raise StopRequested()
        tmp = self.run_dir / 'state.tmp'
        tmp.write_text(value + '\n')
        tmp.replace(self.run_dir / 'state')
        (self.state_dir / 'session.changed').write_text('changed\n')

    def show(self):
        """Publish the subtitles; the caller holds the lock."""
        tmp = self.state_dir / 'translate.subtitles.tmp'
        tmp.write_text(json.dumps({'lines': list(self.subtitles)}) + '\n')
        tmp.replace(self.state_dir / 'translate.subtitles')

    def mark(self, inflight=0, hearing=None):
        """translate.showing exists while a phrase is heard, translated or spoken, until its English has played."""
        with self.lock:
            self.inflight += inflight
            if hearing is not None:
                self.hearing = hearing
            showing = bool(self.hearing or self.inflight or time.monotonic() < self.played_end)
            if showing != self.showing:
                marker = self.state_dir / 'translate.showing'
                if showing:
                    marker.touch()
                else:
                    marker.unlink(missing_ok=True)
                self.showing = showing

    def queue(self, phrase, text, joined=False, ended=False, last=False, **trace):
        """Hand a piece of English to the voice; joined carries on inside the last word."""
        piece = {'text': text, 'start': None, 'end': None}
        phrase.english = phrase.english + text if joined else f'{phrase.english} {text}'.strip()
        self.trace(phrase, 'queue', text=text, last=last, **trace)
        with self.lock:
            phrase.shown['pieces'].append(piece)
            phrase.shown['english'] = phrase.english
            phrase.waiting += 1
            self.show()
        phrase.segments.put((piece, last, joined, ended or last))

    def on_air(self, piece, **times):
        """Publish when a piece starts and stops playing, in Unix time so the HUD can compare it to its clock."""
        offset = time.time() - time.monotonic()
        with self.lock:
            piece.update({key: round(value + offset, 3) for key, value in times.items()})
            self.show()

    def heard(self, phrase, text, live=True):
        """Publish what was heard of the phrase; live while it may still change."""
        with self.lock:
            phrase.shown.update(dutch=text, live=live)
            self.show()

    def gate(self, phrase, piece):
        """Why settled English waits for the voice, or None when it goes now; with the voice's audio
        left, the English in hand with this piece, and the usual wait for the next piece."""
        now = time.monotonic()
        voice_left, cover, wait = self.voice_end - now, 0.0, None
        if piece:
            if phrase.committed_at is not None:
                self.refill.append(now - phrase.committed_at)
                phrase.committed_at = None
            # Seconds of English in hand with this piece, if the voice slows to its slowest pace.
            cover = max(0.0, voice_left) + self.voice.seconds(piece) / self.speed_min
            if voice_left > statistics.fmean(self.first_audio) + statistics.fmean(self.cycle):
                # Later is better while the voice has enough: more of the English is settled by then.
                wait = 'voice-busy'
            elif cover < statistics.fmean(self.refill) * GUARD:
                # The voice would run dry in the middle of a sentence before more is settled.
                wait = 'would-run-dry'
            else:
                phrase.committed_at = now
        return wait, voice_left, cover, statistics.fmean(self.refill)

    def finish(self, phrase):
        """No more English for this phrase."""
        with self.lock:
            phrase.shown['done'] = True
            self.show()
        phrase.segments.put(None)

    def drop(self, phrase):
        """Nothing was said: the phrase leaves the subtitles."""
        with self.lock:
            kept = [shown for shown in self.subtitles if shown is not phrase.shown]
            self.subtitles.clear()
            self.subtitles.extend(kept)
            self.show()
        phrase.segments.put(None)

    def call(self, action):
        child = subprocess.Popen([self.command, '_translate', action], env=dict(os.environ))
        child.wait()
        if child.returncode:
            raise RuntimeError(f'translate {action} failed ({child.returncode})')

    def guard(self, work):
        def run():
            try:
                work()
            except Exception as error:
                self.error = error
        threading.Thread(target=run, daemon=True).start()

    def read_audio(self):
        while not self.stopping.is_set():
            frame = self.capture.stdout.read(FRAME_BYTES)
            if len(frame) != FRAME_BYTES:
                raise RuntimeError('microphone stream ended')
            try:
                self.frames.put_nowait(frame)
            except queue.Full as error:
                raise RuntimeError('translation fell over 120 seconds behind capture') from error

    def send(self, pcm, record):
        """Play audio and return when it starts; record collects what the microphone carried, silences too."""
        start = max(time.monotonic(), self.played_end)
        if record is not None:
            if record:
                record.extend(bytes(2 * round((start - self.played_end) * self.voice.sample_rate)))
            record.extend(pcm)
        self.played_end = start + len(pcm) / 2 / self.voice.sample_rate
        for player in self.players:
            player.stdin.write(pcm)
            player.stdin.flush()
        return start

    def keep(self, phrase, english):
        """Save what was heard and what was said, to listen back to a phrase."""
        names = (f'{phrase.number:03d}-{self.language}.wav', f'{phrase.number:03d}-en.wav')
        for name, pcm, rate in ((names[0], phrase.audio, 16000), (names[1], english, self.voice.sample_rate)):
            with wave.open(str(self.recordings / name), 'wb') as sound:
                sound.setnchannels(1)
                sound.setsampwidth(2)
                sound.setframerate(rate)
                sound.writeframes(pcm[:len(pcm) // 2 * 2])
        return names

    def speak(self):
        logs = [(self.run_dir / 'lines.log').open('a', buffering=1)]
        if self.recordings:
            logs.append((self.recordings / 'lines.log').open('a', buffering=1))
        while True:
            phrase = self.lines.get()
            first, pieces, waits, stalls = None, [], [], []
            record = bytearray() if self.recordings else None
            while True:
                try:
                    item = phrase.segments.get(timeout=.05)
                except queue.Empty:
                    if pieces and (ticked := self.tick(record)) is not None:
                        self.trace(phrase, 'tick', start=ticked)
                    continue
                if item is None:
                    break
                piece, last, joined, ended = item
                pieces.append(piece['text'])
                start, began = None, time.monotonic()
                with self.lock:
                    phrase.waiting -= 1
                cover = max(0.0, self.voice_end - began) + self.voice.seconds(piece['text']) / self.speed
                self.speaking = (phrase, last, cover)
                self.trace(phrase, 'tts_start', text=piece['text'], pace=round(self.pace(), 3))
                for i, chunk in enumerate(self.voice.stream(piece['text'], last, joined)):
                    now = time.monotonic()
                    if start is None:
                        self.first_audio.append(now - began)
                    if first is None:
                        first = now
                    # The players had run out of English: silence the listener heard.
                    quiet = now - self.voice_end
                    if first != now and quiet > 0:
                        (stalls if i else waits).append(quiet)
                        if i:
                            self.trace(phrase, 'stall', quiet=round(quiet, 3))
                    self.voice_end = max(self.voice_end, now) + len(chunk) / 2 / self.voice.sample_rate
                    begins = self.send(chunk, record)
                    if start is None:
                        start = begins
                        self.on_air(piece, start=start)
                        self.trace(phrase, 'tts_first', text=piece['text'])
                if start is None:
                    start = max(time.monotonic(), self.played_end)
                self.on_air(piece, start=start, end=max(start, self.played_end))
                self.ended = ended
                self.trace(phrase, 'tts_end', text=piece['text'])
                self.trace(phrase, 'play', text=piece['text'], start=start, end=max(start, self.played_end))
            self.voice.end()
            self.trace(phrase, 'spoken', end=self.played_end if first is not None else None)
            if first is not None:
                entry = (f'{phrase.shown["dutch"]}\n  -> {phrase.english}\n'
                         f'  spoken as: {" | ".join(pieces)}\n'
                         f'  voice began {first - phrase.started:.2f}s after you did, '
                         f'{first - phrase.ended:+.2f}s from your pause\n'
                         f'  silence before later pieces: {sum(waits):.2f}s in {len(waits)}, '
                         f'stutter inside pieces: {sum(stalls):.2f}s in {len(stalls)}\n')
                if self.recordings:
                    entry += '  audio: {}, {}\n'.format(*self.keep(phrase, bytes(record)))
                for log in logs:
                    log.write(entry)
            self.mark(-1)

    def pace(self):
        """The voice's pace now: faster while English waits behind it, slower while none is coming
        soon, so the English in hand lasts until the next piece is usually settled."""
        if self.speaking is None:
            return self.speed
        phrase, last, cover = self.speaking
        if phrase.waiting or (last and not self.lines.empty()):
            return self.speed_max
        if last:
            return self.speed
        return min(self.speed, max(self.speed_min, self.speed * cover / statistics.fmean(self.refill)))

    def tick(self, record):
        """Inside a sentence, tick softly while the voice waits, so listeners know the speaker has not stopped.

        The tick is not English, so it does not move voice_end: the pieces still go out as
        soon as the voice needs them. After a piece that may end a sentence, silence is natural.
        """
        now = time.monotonic()
        if self.tick_sound and not self.ended and now >= max(self.voice_end + TICK_AFTER_S, self.next_tick):
            self.next_tick = now + TICK_EVERY_S
            return self.send(self.tick_sound, record)
        return None

    def player(self, device):
        command = ['pacat', '--playback', '--raw', '--format=s16le', f'--rate={self.voice.sample_rate}',
                   '--channels=1', '--latency-msec=60', '--client-name=talkey', '--stream-name=translation']
        if device:
            command.append(f'--device={device}')
        return subprocess.Popen(command, stdin=subprocess.PIPE)

    def run(self):
        deadline = time.monotonic() + 5
        while not (self.run_dir / 'worker.pid.start').exists():
            if time.monotonic() > deadline:
                raise RuntimeError('translator identity was not published')
            time.sleep(.01)
        # The engine loads while PyTorch and the voice load; the first phrase is not slow.
        with ThreadPoolExecutor(max_workers=1) as pool:
            warming = pool.submit(self.engine.start)
            try:
                self.voice = Voice(self.voice_path)
                # Also the first measure of how long the voice takes to start and to say a sentence.
                began = time.monotonic()
                for i, _ in enumerate(self.voice.stream('Hello, this is how the voice sounds today.')):
                    if not i:
                        self.first_audio.append(time.monotonic() - began)
                self.voice.end()
                self.voice.pace = self.pace
                warming.result()
            except BaseException:
                # Leaving the block waits for start; a stop or an error ends the load first.
                self.engine.close()
                raise
        self.tick_sound = wait_sound(self.voice.sample_rate)
        self.players.append(self.player(os.environ.get('TALKEY_TRANSLATE_SINK', 'talkey_translate')))
        if os.environ.get('TALKEY_TRANSLATE_MONITOR', '0') == '1':
            self.players.append(self.player(None))
        self.capture = subprocess.Popen([
            os.environ.get('TALKEY_FFMPEG', 'ffmpeg'), '-nostdin', '-hide_banner', '-loglevel', 'error',
            '-f', 'pulse', '-i', os.environ.get('TALKEY_SOURCE', 'default'),
            '-ac', '1', '-ar', '16000', '-f', 's16le', '-'], stdout=subprocess.PIPE)
        for work in (self.read_audio, self.speak):
            self.guard(work)
        self.call('ready')
        phrase = None
        recent, level = deque(maxlen=4), self.state_dir / 'translate.raw'
        while True:
            if self.error:
                raise self.error
            if self.showing and not (self.hearing or self.inflight):
                self.mark()
            try:
                frame = self.frames.get(timeout=.1)
            except queue.Empty:
                continue
            recent.append(frame)
            # The HUD meters the microphone while it shows a phrase; idle, nothing is written.
            if self.showing and len(recent) == recent.maxlen:
                tmp = self.state_dir / 'translate.raw.tmp'
                tmp.write_bytes(b''.join(recent))
                tmp.replace(level)
                recent.clear()
            speech = self.vad.speech(frame)
            self.trace.frame(speech)
            event = self.endpoint.update(speech)
            if phrase is None:
                self.preroll.append(frame)
            else:
                phrase.frames.append(frame)
            if event == 'start':
                self.count += 1
                phrase = Phrase(time.monotonic(), self.count)
                phrase.frames = list(self.preroll)
                self.preroll.clear()
                if self.trace.file:
                    frames = self.trace.frames
                    phrase.onset = self.trace.clock(frames - self.endpoint.start_frames)
                    phrase.audio_from = self.trace.clock(frames - len(phrase.frames))
                    self.trace(phrase, 'speech_start', detected=phrase.started, audio_from=phrase.audio_from)
                with self.lock:
                    self.subtitles.append(phrase.shown)
                    self.show()
                self.engine.begin(phrase)
                # The speaker takes phrases in the order they began, while their English streams in.
                self.lines.put(phrase)
                self.mark(hearing=True)
                self.state('hearing')
            elif event == 'end':
                phrase.ended = time.monotonic()
                self.trace(phrase, 'speech_end', at=self.trace.clock(self.trace.voiced), endpoint=phrase.ended)
                phrase.audio = b''.join(phrase.frames)
                self.engine.end(phrase)
                phrase = None
                self.mark(1, hearing=False)
                self.state('listening')
            elif phrase is not None:
                self.engine.hear(phrase)

    def close(self):
        self.stopping.set()
        if self.engine:
            self.engine.close()
        for name in ('translate.showing', 'translate.raw'):
            (self.state_dir / name).unlink(missing_ok=True)
        for process in [self.capture] + self.players:
            if process:
                process.terminate()


def export_voice(source, target):
    from pocket_tts import TTSModel, export_model_state
    model = TTSModel.load_model(language=os.environ.get('TALKEY_TRANSLATE_TTS', 'english'))
    if not model.has_voice_cloning:
        raise ValueError('voice cloning weights unavailable: accept the terms at '
                         'https://huggingface.co/kyutai/pocket-tts and run: hf auth login')
    Path(target).parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    export_model_state(model.get_state_for_audio_prompt(source), target)
    # The clone speaks as you; nobody else on the machine should be able to read it.
    os.chmod(target, 0o600)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--check', action='store_true')
    parser.add_argument('--export-voice', nargs=2, metavar=('WAV', 'SAFETENSORS'))
    args = parser.parse_args()
    if args.export_voice:
        export_voice(*args.export_voice)
        return 0
    # Downloads happen in setup. A live session never reaches the network.
    os.environ['HF_HUB_OFFLINE'] = '1'
    signal.signal(signal.SIGTERM, stop_requested)
    signal.signal(signal.SIGINT, stop_requested)
    vad = interpreter = None
    try:
        setting('VAD_START_MS', '160', 32, 2000)
        setting('TRANSLATE_SILENCE_MS', '500', 160, 10000)
        setting('TRANSLATE_MAX_S', '15', 1, 600)
        setting('TRANSLATE_SPEED', '0.95', 0.5, 1.5)
        name = os.environ.get('TALKEY_TRANSLATE_ENGINE', 'whisper')
        if name not in ENGINES:
            raise ValueError('TALKEY_TRANSLATE_ENGINE must be one of: ' + ', '.join(ENGINES))
        engine = ENGINES[name]
        engine.check()
        for name in ('TICK', 'RECORD', 'TRACE'):
            if os.environ.get(f'TALKEY_TRANSLATE_{name}', '1') not in ('0', '1'):
                raise ValueError(f'TALKEY_TRANSLATE_{name} must be 0 or 1')
        if os.environ.get('TALKEY_TRANSLATE_TEMP'):
            setting('TRANSLATE_TEMP', '0.3', 0.05, 1.5)
        voice = default_voice()
        if not Path(voice).is_file():
            raise ValueError(f'no voice at {voice}; run: talkey-setup translate')
        # Finding the package is enough here; importing PyTorch would double the startup.
        if importlib.util.find_spec('pocket_tts') is None:
            raise ValueError('Pocket TTS is not installed in this Python; run: talkey-setup translate')
        vad = Silero()
        if not args.check:
            interpreter = Interpreter(vad, voice, engine)
            interpreter.run()
    except StopRequested:
        pass
    except Exception as error:
        print(f'talkey translate: {error}', file=sys.stderr)
        if interpreter:
            try:
                # The notification names the reason; it never holds what was said.
                (interpreter.run_dir / 'error').write_text(f'{error}\n')
                interpreter.call('error')
            except (Exception, StopRequested):
                pass
        return 1
    finally:
        if interpreter:
            interpreter.close()
        if vad:
            vad.close()
    return 0


if __name__ == '__main__':
    sys.exit(main())
