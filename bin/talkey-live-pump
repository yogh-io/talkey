#!/usr/bin/env python3
# talkey-live-pump - stable live transcription for the dictation overlay.
#
# Whisper is a batch model: re-running it on a growing buffer gives UNSTABLE
# output (words re-interpret as context grows, the tail is held), so showing it
# raw flickers and lags in chunks. This applies the LocalAgreement-2 policy used
# by real streaming ASR (ufal/whisper_streaming, WhisperLiveKit): transcribe the
# growing buffer a few times a second and only COMMIT a word once two
# consecutive passes agree on it. Committed text grows word-by-word, ~1-2 words
# behind speech, and never shrinks. It talks to the SAME whisper.cpp server the
# rest of the system uses; nothing new to run.
#
# Reads the raw PCM capture, writes the agreed text to the transcript file the
# overlay renders. Exits when the recorder's pidfile goes away (recording
# stopped) or on SIGTERM. The accurate final transcript is still produced
# separately by talkey on stop; this only drives the live view.
#
#   talkey-live-pump RAW TRANSCRIPT PIDFILE
#
# Env: TALKEY_WHISPER_URL, TALKEY_LANG, TALKEY_STREAM_INTERVAL, TALKEY_PROMPT
import os, sys, time, re, struct, tempfile, subprocess, signal, traceback

RAW, TRANSCRIPT, PIDFILE = sys.argv[1], sys.argv[2], sys.argv[3]
URL      = os.environ.get("TALKEY_WHISPER_URL", "http://127.0.0.1:8910/inference")
LANG     = os.environ.get("TALKEY_LANG", "en")
INTERVAL = float(os.environ.get("TALKEY_STREAM_INTERVAL", "0.35"))
# Stop re-transcribing once the buffer passes this many seconds. Each pass re-runs
# whisper on the WHOLE buffer, so cost grows with length; past a minute the live
# view is degraded anyway (whisper's 30s window) and the churn is pure load. The
# final transcript talkey makes on release is still complete - this only pauses the
# live preview, and is a second backstop to talkey's hard recording cap.
MAX_PUMP_S = float(os.environ.get("TALKEY_MAX_PUMP_S", "60"))
BASE_PROMPT = os.environ.get("TALKEY_PROMPT", "")
DEBUG    = os.environ.get("TALKEY_STREAM_DEBUG", "0") == "1"
DIAG     = os.environ.get("TALKEY_DIAG", "")   # durable per-pass trace file (bin/talkey-diag)

def _stamp():
    return time.strftime("%H:%M:%S") + f".{int((time.time()%1)*1000):03d}"

def dbg(msg):
    if DEBUG:
        sys.stderr.write(f"live-pump {msg}\n"); sys.stderr.flush()
    if DIAG:
        try:
            with open(DIAG, "a") as f:
                f.write(f"{_stamp()} pump {msg}\n")
        except OSError:
            pass

_run = True
signal.signal(signal.SIGTERM, lambda *_: globals().__setitem__("_run", False))

def recorder_alive() -> bool:
    try:
        with open(PIDFILE) as f:
            pid = int(f.read().strip())
        os.kill(pid, 0)
        return True
    except Exception:
        return False

def wav_bytes(pcm: bytes) -> bytes:
    n = len(pcm)
    return (b"RIFF" + struct.pack("<I", 36 + n) + b"WAVEfmt " +
            struct.pack("<IHHIIHH", 16, 1, 1, 16000, 32000, 2, 16) +
            b"data" + struct.pack("<I", n) + pcm)

def transcribe(pcm: bytes, prompt: str) -> str:
    with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as f:
        f.write(wav_bytes(pcm)); path = f.name
    try:
        cmd = ["curl", "-sS", "--max-time", "20", URL,
               "-F", f"file=@{path}", "-F", f"language={LANG}",
               "-F", "temperature=0", "-F", "response_format=text"]
        if prompt:
            cmd += ["-F", f"prompt={prompt}"]
        out = subprocess.run(cmd, capture_output=True, text=True).stdout
    finally:
        try: os.unlink(path)
        except OSError: pass
    out = re.sub(r"\[[^\]]*\]", "", out)          # strip [BLANK_AUDIO] etc
    return re.sub(r"\s+", " ", out).strip()

def norm(w: str) -> str:
    return re.sub(r"[^\w]", "", w.lower())

def common_prefix_len(a, b) -> int:
    n = 0
    while n < len(a) and n < len(b) and norm(a[n]) == norm(b[n]):
        n += 1
    return n

def main():
    dbg(f"start url={URL} lang={LANG} interval={INTERVAL}s prompt={len(BASE_PROMPT)}chars")
    prev, shown, last_size, capped = [], [], -1, False
    def write(wl):
        tmp = TRANSCRIPT + ".tmp"
        with open(tmp, "w") as f:
            f.write(" ".join(wl))
        os.replace(tmp, TRANSCRIPT)
    while _run and recorder_alive():
        try:
            size = os.path.getsize(RAW)
        except OSError:
            size = 0
        # Past the cap, stop re-transcribing: the per-pass cost has grown too large
        # to keep paying every INTERVAL. Live preview holds; talkey's final transcript
        # is unaffected. Keep looping so we still exit when the recorder stops.
        if size / 32000 > MAX_PUMP_S:
            if not capped:
                dbg(f"buf={size/32000:.1f}s over MAX_PUMP_S={MAX_PUMP_S}s - live preview paused (final transcript still complete)")
                capped = True
            time.sleep(INTERVAL)
            continue
        # Only re-transcribe when new audio arrived (a pause adds no bytes).
        if size > 32000 and size != last_size:
            last_size = size
            with open(RAW, "rb") as f:
                pcm = f.read()
            t0 = time.time()
            cur = transcribe(pcm, BASE_PROMPT).split()
            ms = int((time.time() - t0) * 1000)
            # LocalAgreement-2: show only the prefix the last two passes agree on
            # (drops whisper's unstable trailing guesses). Recompute every pass -
            # do NOT lock words, or an early re-interpretation stalls forever. Only
            # ever grow what's shown, so the overlay never flickers backward.
            agreed = cur[:common_prefix_len(prev, cur)]
            if cur and len(agreed) > len(shown):
                shown = agreed
                write(shown)
            dbg(f"buf={size/32000:.1f}s pass={ms}ms hyp={len(cur)}w "
                f"agreed={len(agreed)}w shown={len(shown)}w")
            prev = cur
        time.sleep(INTERVAL)
    dbg("exit reason=" + ("sigterm" if not _run else "recorder-gone")
        + f" final_shown={len(shown)}w")

if __name__ == "__main__":
    # Never die silently: a crash here (e.g. a bad call signature) leaves the
    # overlay with no live text and no clue why. Record the full traceback to the
    # diag trace so bin/talkey-diag surfaces it.
    try:
        main()
    except Exception:
        dbg("CRASH\n" + traceback.format_exc())
        raise
