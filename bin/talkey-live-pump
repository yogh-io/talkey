#!/usr/bin/env python3
"""Publish an agreed live preview into one take's private transcript file.

The final transcription is independent. SIGTERM interrupts an in-flight HTTP
request, and recorder identity is checked again before publishing a response.
Only the Python standard library is required.
"""
import argparse
import io
import os
from pathlib import Path
import re
import signal
import sys
import time
import traceback
import urllib.error
import urllib.request
import uuid
import wave


class StopRequested(Exception):
    """Normal worker shutdown, including during network I/O."""


def stop_requested(*_):
    raise StopRequested()


def normalized(word):
    return re.sub(r"[^\w]", "", word.casefold())


class Agreement:
    """Two successive hypotheses must agree before the preview grows."""
    def __init__(self):
        self.previous = []
        self.shown = []

    def update(self, text):
        current = text.split()
        count = 0
        for old, new in zip(self.previous, current):
            if normalized(old) != normalized(new):
                break
            count += 1
        self.previous = current
        if count > len(self.shown):
            self.shown = current[:count]
            return " ".join(self.shown)
        return None


def wav_bytes(pcm, sample_rate=16000, channels=1):
    output = io.BytesIO()
    with wave.open(output, "wb") as wav:
        wav.setnchannels(channels)
        wav.setsampwidth(2)
        wav.setframerate(sample_rate)
        wav.writeframes(pcm[:len(pcm) // (2 * channels) * (2 * channels)])
    return output.getvalue()


def transcribe(pcm, url, language, prompt, sample_rate, channels):
    boundary = uuid.uuid4().hex
    fields = {"language": language, "temperature": "0", "response_format": "text"}
    if prompt:
        fields["prompt"] = prompt
    parts = []
    for key, value in fields.items():
        parts.append(f'--{boundary}\r\nContent-Disposition: form-data; name="{key}"\r\n\r\n{value}\r\n'.encode())
    parts.append(f'--{boundary}\r\nContent-Disposition: form-data; name="file"; filename="audio.wav"\r\nContent-Type: audio/wav\r\n\r\n'.encode())
    parts += [wav_bytes(pcm, sample_rate, channels), f'\r\n--{boundary}--\r\n'.encode()]
    request = urllib.request.Request(url, data=b"".join(parts), headers={
        "Content-Type": f"multipart/form-data; boundary={boundary}"})
    with urllib.request.urlopen(request, timeout=20) as response:
        text = response.read().decode("utf-8")
    text = re.sub(r"\[[^\]]*\]|\*[^*]*\*", "", text)
    return re.sub(r"\s+", " ", text).strip()


def recorder_identity(pidfile):
    try:
        pid = pidfile.read_text().strip()
        if not pid.isdecimal():
            return None
        stat = Path(f"/proc/{pid}/stat").read_text().rsplit(") ", 1)[1].split()
        if stat[0] == "Z":
            return None
        expected = pidfile.with_name(pidfile.name + ".start")
        if expected.exists() and expected.read_text().strip() != stat[19]:
            return None
        return pid, stat[19]
    except (OSError, IndexError):
        return None


class Pump:
    def __init__(self, raw, transcript, pidfile):
        self.raw, self.transcript, self.pidfile = map(Path, (raw, transcript, pidfile))
        self.url = os.environ.get("TALKEY_WHISPER_URL", "http://127.0.0.1:8910/inference")
        self.language = os.environ.get("TALKEY_LANG", "en")
        self.interval = float(os.environ.get("TALKEY_STREAM_INTERVAL", "0.3"))
        self.cap = float(os.environ.get("TALKEY_MAX_PUMP_S", "60"))
        self.sample_rate = int(os.environ.get("TALKEY_SAMPLE_RATE", "16000"))
        self.channels = int(os.environ.get("TALKEY_CHANNELS", "1"))
        if min(self.interval, self.cap, self.sample_rate, self.channels) <= 0:
            raise ValueError("stream interval, cap, sample rate and channels must be positive")
        self.prompt = os.environ.get("TALKEY_PROMPT", "")
        self.identity = recorder_identity(self.pidfile)
        self.agreement = Agreement()

    def alive(self):
        return self.identity is not None and recorder_identity(self.pidfile) == self.identity

    def infer(self, pcm):
        return transcribe(pcm, self.url, self.language, self.prompt, self.sample_rate, self.channels)

    def publish(self, text):
        tmp = self.transcript.with_name(f"{self.transcript.name}.{os.getpid()}.tmp")
        try:
            tmp.write_text(text)
            if self.alive():
                os.replace(tmp, self.transcript)
        finally:
            tmp.unlink(missing_ok=True)

    def run(self):
        trace(f"start url={self.url} lang={self.language} interval={self.interval}s")
        last_size, capped = -1, False
        bytes_per_second = self.sample_rate * self.channels * 2
        while self.alive():
            try:
                size = self.raw.stat().st_size
            except FileNotFoundError:
                break
            seconds = size / bytes_per_second
            if seconds > self.cap:
                if not capped:
                    trace(f"buf={seconds:.1f}s over MAX_PUMP_S={self.cap}s - live preview paused")
                    capped = True
            elif size > bytes_per_second and size != last_size:
                start = time.monotonic()
                try:
                    text = self.infer(self.raw.read_bytes())
                except (OSError, urllib.error.URLError, UnicodeError) as error:
                    trace(f"request failed: {error}")
                else:
                    if not self.alive():
                        break
                    last_size = size
                    agreed = self.agreement.update(text)
                    if agreed is not None:
                        self.publish(agreed)
                    trace(f"buf={seconds:.1f}s pass={int((time.monotonic()-start)*1000)}ms "
                          f"hyp={len(text.split())}w shown={len(self.agreement.shown)}w")
            time.sleep(self.interval)


def trace(message):
    line = f"{time.strftime('%H:%M:%S')} pump {message}\n"
    if os.environ.get("TALKEY_STREAM_DEBUG") == "1":
        print(line, end="", file=sys.stderr)
    if path := os.environ.get("TALKEY_DIAG"):
        try:
            with open(path, "a") as output:
                output.write(line)
        except OSError:
            pass


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("raw")
    parser.add_argument("transcript")
    parser.add_argument("pidfile")
    args = parser.parse_args()
    signal.signal(signal.SIGTERM, stop_requested)
    signal.signal(signal.SIGINT, stop_requested)
    try:
        Pump(args.raw, args.transcript, args.pidfile).run()
    except StopRequested:
        trace("exit reason=signal")
    except Exception:
        trace("CRASH\n" + traceback.format_exc())
        raise
    else:
        trace("exit reason=recorder-gone")


if __name__ == "__main__":
    main()
