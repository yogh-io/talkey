#!/usr/bin/env bash
# talkey-whisper-server - start the local STT server. The systemd unit calls
# this, so there is exactly ONE place that knows where the whisper binary and
# the model live.
#
# Two supported layouts, probed in order, no guessing beyond them:
#   1. distro package  (extra/whisper-cpp + whisper.cpp-model-* from the AUR)
#   2. built by setup/build-whisper.sh into ~/.local/opt and ~/.local/share
# Set TALKEY_WHISPER_SERVER / TALKEY_MODEL to point somewhere else entirely.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
for _l in "${TALKEY_DATA_DIR:-/nonexistent}/lib" "$SCRIPT_DIR/../lib" /usr/share/talkey/lib; do
  [[ -f "$_l/common.sh" ]] && { . "$_l/common.sh" || exit 1; break; }
done

MODEL_NAME="${TALKEY_MODEL_NAME:-large-v3-turbo}"
HOST="${TALKEY_WHISPER_HOST:-127.0.0.1}"
PORT="${TALKEY_WHISPER_PORT:-8910}"
# Derived, not configured: half the cores, capped at 8. whisper gains little
# past that, and leaving headroom keeps the desktop responsive while it decodes.
if [[ -z "${TALKEY_WHISPER_THREADS:-}" ]]; then
  _cores="$(nproc 2>/dev/null || echo 4)"
  THREADS=$(( _cores / 2 )); (( THREADS < 1 )) && THREADS=1; (( THREADS > 8 )) && THREADS=8
else
  THREADS="$TALKEY_WHISPER_THREADS"
fi

BIN="$(talkey_binary whisper-server "${TALKEY_WHISPER_SERVER:-}")" || {
  echo "talkey: no whisper-server found - run talkey-setup" >&2; exit 1;
}
MODEL="$(talkey_model_path "$MODEL_NAME" "${TALKEY_MODEL:-}")" || {
  echo "talkey: no $MODEL_NAME model found - run talkey-setup model" >&2; exit 1;
}
echo "talkey: whisper-server=$BIN model=$MODEL threads=$THREADS" >&2
# NEVER pass --no-timestamps. It reads like a formatting flag ("do not print
# timestamps") but it changes decoding: with no timestamp tokens whisper cannot
# tell where the last sentence ended, so it stops advancing to that point and
# hard-cuts the audio into fixed 30 second blocks instead. Whatever you were
# saying across a cut is mangled or lost - measured on real dictations, every
# clip over 30s lost a clause at each boundary ("I move the mouse to another
# window" simply vanished). Leaving it off makes whisper seek by sentence, which
# is what lets it transcribe input of any length. See README, "long dictations".
#
# Cost of leaving it off: whisper now also splits segments at --max-len
# characters, and whisper-server forces that to 60 when unset - which without
# --split-on-word can cut mid-word. So set both: split on words, and a limit
# long enough that natural sentence boundaries decide instead.
exec "$BIN" --model "$MODEL" --host "$HOST" --port "$PORT" --threads "$THREADS" \
     --split-on-word --max-len 1000
