#!/usr/bin/env bash
# talkey-whisper-server - start the local STT server. The systemd unit calls
# this, so there is exactly ONE place that knows where the whisper binary and
# the model live.
#
# Two supported layouts, probed in order, no guessing beyond them:
#   1. distro package  (extra/whisper-cpp + whisper.cpp-model-* from the AUR)
#   2. built by setup/build-whisper.sh into ~/.local/opt and ~/.local/share
# Set TALKEY_WHISPER_SERVER / TALKEY_MODEL to point somewhere else entirely.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
for _l in "$SCRIPT_DIR/../lib" /usr/share/talkey/lib; do
  [[ -f "$_l/common.sh" ]] && { . "$_l/common.sh"; break; }
done

MODEL_NAME="${TALKEY_MODEL_NAME:-large-v3-turbo}"
HOST="${TALKEY_WHISPER_HOST:-127.0.0.1}"
PORT="${TALKEY_WHISPER_PORT:-8910}"
# Derived, not configured: half the cores, capped at 8. whisper gains little
# past that, and leaving headroom keeps the desktop responsive while it decodes.
if [[ -z "${TALKEY_WHISPER_THREADS:-}" ]]; then
  _cores="$(nproc 2>/dev/null || echo 4)"
  THREADS=$(( _cores / 2 )); (( THREADS < 1 )) && THREADS=1; (( THREADS > 8 )) && THREADS=8
else
  THREADS="$TALKEY_WHISPER_THREADS"
fi

# Probe order matters: a build in ~/.local wins over the distro package. The
# AUR package depends on whisper-cpp, so /usr/bin/whisper-server exists on every
# packaged install - and it is CPU-only. Preferring it would silently undo the
# GPU rebuild the README recommends.
BIN="${TALKEY_WHISPER_SERVER:-}"
if [[ -z "$BIN" ]]; then
  for c in "$HOME/.local/opt/whisper.cpp/build/bin/whisper-server" /usr/bin/whisper-server; do
    if [[ -x "$c" ]]; then BIN="$c"; break; fi
  done
fi
[[ -n "$BIN" ]] || {
  echo "talkey: no whisper-server found. Install the 'whisper-cpp' package, or run setup/build-whisper.sh." >&2
  exit 1
}

MODEL="${TALKEY_MODEL:-}"
if [[ -z "$MODEL" ]]; then
  for c in "$HOME/.local/share/whisper/ggml-$MODEL_NAME.bin" \
           "/usr/share/whisper.cpp-model-$MODEL_NAME/ggml-$MODEL_NAME.bin"; do
    if [[ -f "$c" ]]; then MODEL="$c"; break; fi
  done
fi
[[ -n "$MODEL" ]] || {
  echo "talkey: no $MODEL_NAME model found. Install 'whisper.cpp-model-$MODEL_NAME' (AUR), or run setup/build-whisper.sh." >&2
  exit 1
}

# Say what was picked. "why is it slow" is nearly always the CPU build being
# used when a GPU build exists, and this is the one place that knows.
echo "talkey: whisper-server=$BIN model=$MODEL threads=$THREADS" >&2
exec "$BIN" --model "$MODEL" --host "$HOST" --port "$PORT" --threads "$THREADS" --no-timestamps
