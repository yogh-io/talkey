#!/usr/bin/env bash
# talkey-mic-check - sweep the archived recordings for mic-level problems.
#
# The overlay flags a single clip's level live (red meter) and after the fact
# (the peak reading). This is the corpus view: run it over everything in the
# archive to see whether the mic is set up right OVERALL - is it clipping a lot,
# sitting too faint, or all over the place.
#
# These are deliberately NOT the live meter's thresholds. The meter grades one
# clip as you speak (TALKEY_PEAK_LOUD_DB / _LOW_DB, the green band); this grades
# a whole corpus, where what matters is how often you actually hit the ceiling
# or the floor - so it uses the tighter TALKEY_PEAK_CLIP_DB / _FAINT_DB.
#
#   talkey-mic-check              # summary over the default archive dir
#   talkey-mic-check DIR          # over another dir
#   talkey-mic-check --worst      # summary + the worst clippers and faintest clips
#
# Peak level is the loudest sample as dBFS (0 = full scale). Near 0 = clipping
# (mic too close / gain too high); far below = faint (whisper hears near-silence
# and hallucinates filler). ffmpeg's astats Peak_level is that same number.
set -u

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
for _l in "$SCRIPT_DIR/../lib" /usr/share/talkey/lib; do
  [[ -f "$_l/common.sh" ]] && { . "$_l/common.sh"; break; }
done
WORST=0
DIR=""
for a in "$@"; do
  case "$a" in
    --worst) WORST=1 ;;
    -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) DIR="$a" ;;
  esac
done
DIR="${DIR:-${TALKEY_ARCHIVE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/talkey/recordings}}"
CLIP_DB="${TALKEY_PEAK_CLIP_DB:--1}"     # peak at/above this = clipping outright
FAINT_DB="${TALKEY_PEAK_FAINT_DB:--18}"  # peak never above this = too faint to trust

command -v ffmpeg >/dev/null 2>&1 || { echo "ffmpeg required"; exit 1; }
[[ -d "$DIR" ]] || { echo "no such dir: $DIR"; exit 1; }

# Collect "peak_db<TAB>rms_db<TAB>file" for every wav. astats gives both in one
# decode; -inf peak (a truly empty file) is dropped as unmeasurable.
tsv="$(
  for f in "$DIR"/*.wav; do
    [[ -e "$f" ]] || continue
    ffmpeg -hide_banner -nostats -i "$f" \
        -af astats=metadata=1:reset=0,ametadata=mode=print:file=- -f null /dev/null 2>/dev/null \
      | awk -F= -v file="${f##*/}" '
          /Overall.Peak_level/ {pk=$2}
          /Overall.RMS_level/  {rms=$2}
          END{ if(pk!="" && pk!="-inf") printf "%s\t%s\t%s\n", pk, rms, file }'
  done
)"

n="$(printf '%s\n' "$tsv" | grep -c . )"
(( n > 0 )) || { echo "no measurable recordings in $DIR"; exit 0; }

printf '\nmic-level sweep of %s\n%d recordings  ·  clip>=%sdB  faint<=%sdB\n\n' \
  "$DIR" "$n" "$CLIP_DB" "$FAINT_DB"

printf '%s\n' "$tsv" | awk -F'\t' -v clip="$CLIP_DB" -v faint="$FAINT_DB" '
  { n++; pk=$1+0; rms=$2+0; speak+=pk; srms+=rms
    if(pk>=clip)clipc++; else if(pk>-6)hot++; else if(pk>-12)ideal++; else if(pk<=faint)faintc++; else lowc++
  }
  function bar(c,   i,s){ s=""; for(i=0;i<int(40*c/n+0.5);i++)s=s"#"; return s }
  END{
    printf "avg peak level : %6.1f dBFS   (ideal band -12..-6)\n", speak/n
    printf "avg RMS level  : %6.1f dBFS   (speech loudness)\n\n", srms/n
    printf "peak distribution:\n"
    printf "  clipping  >=%sdB : %4d %3.0f%%  %s\n", clip, clipc, 100*clipc/n, bar(clipc)
    printf "  hot     -6..%sdB : %4d %3.0f%%  %s\n", clip, hot,  100*hot/n,  bar(hot)
    printf "  ideal    -12..-6 : %4d %3.0f%%  %s\n", ideal, 100*ideal/n, bar(ideal)
    printf "  low    %sdB..-12 : %4d %3.0f%%  %s\n", faint, lowc, 100*lowc/n, bar(lowc)
    printf "  faint    <=%sdB : %4d %3.0f%%  %s\n", faint, faintc, 100*faintc/n, bar(faintc)
    print ""
    hotpct=100*(clipc+hot)/n; lowpct=100*(lowc+faintc)/n
    if(clipc>0.10*n)  print "-> clipping often: move the mic back or lower input gain."
    else if(faintc>0.08*n) print "-> faint clips leak whisper hallucinations (\"thank you\") - mic too far / wrong source."
    else if(hotpct>60) print "-> running hot overall: a little more distance would add headroom."
    else if(hotpct<40 && lowpct<15) print "-> levels look healthy."
    else print "-> levels are workable but uneven - a fixed mic distance would tighten them up."
  }'

if (( WORST )); then
  echo; echo "hottest (clipping):"
  printf '%s\n' "$tsv" | sort -t"$(printf '\t')" -k1,1 -rn | head -8 \
    | awk -F'\t' '{printf "  %7s dB  %s\n", $1, $3}'
  echo; echo "faintest:"
  printf '%s\n' "$tsv" | sort -t"$(printf '\t')" -k1,1 -n | head -8 \
    | awk -F'\t' '{printf "  %7s dB  %s\n", $1, $3}'
fi
