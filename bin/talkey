#!/usr/bin/env bash
# Push-to-talk dictation. Integration lives here; behavior lives in lib/.
set -euo pipefail
USAGE='usage: talkey dictate|dictate-alt|memo press|release|start|stop | talkey auto start|stop|toggle|status|enter-on|enter-off|enter-toggle | talkey submit | talkey help | talkey doctor'
MODE="${1:-}"; ACTION="${2:-}"
case "$MODE/$ACTION" in
  --help/|-h/) printf '%s\n' "$USAGE"; exit 0 ;;
  dictate/press|dictate/release|dictate/start|dictate/stop|dictate-alt/press|dictate-alt/release|dictate-alt/start|dictate-alt/stop|memo/press|memo/release|memo/start|memo/stop|submit/|help/|doctor/) ;;
  auto/start|auto/stop|auto/toggle|auto/status|auto/enter-on|auto/enter-off|auto/enter-toggle|_auto/begin|_auto/finish|_auto/error|_auto/idle|_gesture/fire) ;;
  *) printf '%s\n' "$USAGE" >&2; exit 2 ;;
esac
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
for _l in "${TALKEY_DATA_DIR:-/nonexistent}/lib" "$SCRIPT_DIR/../lib" /usr/share/talkey/lib; do
  if [[ -f "$_l/common.sh" ]]; then . "$_l/common.sh" || exit 1; break; fi
done
[[ -n "${DATA_DIR:-}" ]] || { echo 'talkey: cannot find lib/common.sh' >&2; exit 1; }
[[ "$MODE" != doctor ]] || exec "$SCRIPT_DIR/talkey-doctor"
LANG_OVERRIDE=''
if [[ "$MODE" == dictate-alt ]]; then
  MODE=dictate; LANG_OVERRIDE="${TALKEY_LANG2:-}"
  [[ -n "$LANG_OVERRIDE" ]] || { echo 'talkey: set TALKEY_LANG2 for dictate-alt' >&2; exit 1; }
fi
for module in settings session display output transcription archive recording gestures auto controller; do
  . "$DATA_DIR/lib/$module.sh"
done
SOUND_DIR="${TALKEY_SOUND_DIR:-$DATA_DIR/sounds}"
HELP_ON="$STATE_DIR/help.on"; ALERT="$STATE_DIR/dictate.alert"
PROMPT="$(build_prompt)"
EVENT_MS="$(now_ms)"
command -v flock >/dev/null || { echo 'talkey: flock (util-linux) is required' >&2; exit 1; }
exec 9>"$STATE_DIR/command.lock"
lock_commands
session_paths "$STATE_DIR"
adopt_legacy_processes
main
