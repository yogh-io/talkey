#!/usr/bin/env bash
# talkey-setup - the interactive first run: choose a speech model, start the
# server, and turn the keys you actually press into a bindings file.
#
# The two things a README cannot do for you are choosing a model (the sizes and
# tradeoffs are real, and the right answer depends on your GPU) and finding a
# keycode (which needs the key in your hand). This does both, and nothing else
# that documentation already covers.
#
# It installs nothing. Your package manager is yours, and a model is an install
# whichever way it arrives - so this says which one and how, with the official
# links, and leaves the running of it to you. What it does do is enable talkey's
# own systemd unit, after asking, and write talkey's own config files.
#
#   talkey-setup            # everything, in order
#   talkey-setup model      # just the model
#   talkey-setup keys       # just the key bindings - re-run to rebind later
#   talkey-setup service    # just the whisper service
#
# Safe to re-run: every step reports what is already done and moves on. It never
# edits a file it did not create - your WM config is yours, and the last step
# prints the one line to add to it.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
for _l in "$SCRIPT_DIR/../lib" /usr/share/talkey/lib; do
  [[ -f "$_l/common.sh" ]] && { . "$_l/common.sh"; break; }
done
[[ -n "${DATA_DIR:-}" ]] || { echo "talkey-setup: cannot find lib/common.sh" >&2; exit 1; }

CONFIG_DIR="$(dirname "$TALKEY_CONFIG")"
MODEL_DIR="${WHISPER_MODEL_DIR:-$HOME/.local/share/whisper}"

# --- output ----------------------------------------------------------------
if [[ -t 1 ]]; then
  B=$'\e[1m'; DIM=$'\e[2m'; GREEN=$'\e[32m'; YELLOW=$'\e[33m'; R=$'\e[0m'
else
  B=""; DIM=""; GREEN=""; YELLOW=""; R=""
fi
step()  { printf '\n%s== %s%s\n' "$B" "$*" "$R"; }
ok()    { printf '   %s+%s %s\n' "$GREEN" "$R" "$*"; }
info()  { printf '   %s-%s %s\n' "$DIM" "$R" "$*"; }
warn()  { printf '   %s!%s %s\n' "$YELLOW" "$R" "$*"; }
die()   { printf '\ntalkey-setup: %s\n' "$*" >&2; exit 1; }

ask_yn() {  # ask_yn "question" [y|n] -> 0 for yes
  local q="$1" def="${2:-y}" a prompt="[Y/n]"
  [[ "$def" == n ]] && prompt="[y/N]"
  while true; do
    # A closed stdin used to re-prompt forever. It means nobody is there to
    # answer, so stop rather than spin.
    read -r -p "   $q $prompt " a || { printf '\n'; die "input ended - nothing was changed"; }
    a="${a:-$def}"
    case "${a,,}" in y|yes) return 0 ;; n|no) return 1 ;; esac
  done
}

# choose "question" "label1" "label2" ... -> index (1-based) on stdout
# The menu goes to stderr for the same reason capture_keycode's prompt does: the
# caller reads the answer from stdout, so anything printed there is swallowed.
choose() {
  local q="$1"; shift
  local n=$# i a
  printf '   %s\n' "$q" >&2
  for ((i=1; i<=n; i++)); do printf '     %d) %s\n' "$i" "${!i}" >&2; done
  while true; do
    read -r -p "   choice [1-$n]: " a || { printf '\n' >&2; die "input ended - nothing was changed"; }
    [[ "$a" =~ ^[0-9]+$ ]] && (( a >= 1 && a <= n )) && { printf '%s' "$a"; return 0; }
  done
}

have() { command -v "$1" >/dev/null 2>&1; }

# talkey runs on any X11 desktop with bash - the AUR package is one way in, not
# the only one. Package names differ per distro and guessing them wrong sends
# people looking for something that does not exist under that name, so name the
# COMMANDS, and only spell out packages where we can actually tell.
declare -A ARCH_PKG=(
  [ffmpeg]=ffmpeg      [paplay]=libpulse       [xdotool]=xdotool
  [xset]=xorg-xset     [curl]=curl             [xev]=xorg-xev
  [jq]=jq              [python3]=python        [inotifywait]=inotify-tools
  [notify-send]=libnotify
)
# Not in any official repo, so `pacman -S` answers "target not found" - which is
# a worse message than no message, because it reads as talkey being wrong about
# its own dependency.
declare -A AUR_PKG=([eww]=eww)
pkg_hint() {  # pkg_hint <command>...
  local c repo=() aur=()
  if ! have pacman; then
    printf 'install whatever your distro calls the packages providing: %s' "$*"
    return
  fi
  for c in "$@"; do
    if [[ -n "${AUR_PKG[$c]:-}" ]]; then aur+=("${AUR_PKG[$c]}"); else repo+=("${ARCH_PKG[$c]:-$c}"); fi
  done
  (( ${#repo[@]} )) && printf 'sudo pacman -S %s' "${repo[*]}"
  (( ${#repo[@]} && ${#aur[@]} )) && printf '\n   '
  (( ${#aur[@]} )) && printf 'from the AUR (not in the official repos): %s' "${aur[*]}"
}

# --- what is still outstanding ---------------------------------------------
# Steps that cannot finish record why here instead of failing quietly, and the
# summary prints the list. "done." used to be unconditional, so a run where the
# server never answered and no keys were bound still ended by telling you to
# hold your dictate key and speak. Any step added later gets a truthful ending
# by calling todo once.
TODO=()
todo() { TODO+=("$1"); }

# --- config file -----------------------------------------------------------
# Written one key at a time so re-running never clobbers settings from an
# earlier run, or anything you added by hand.
config_set() {
  local key="$1" val="$2"
  mkdir -p "$CONFIG_DIR"
  if [[ ! -f "$TALKEY_CONFIG" ]]; then
    if [[ -f "$DATA_DIR/config/talkey.env.example" ]]; then
      cp "$DATA_DIR/config/talkey.env.example" "$TALKEY_CONFIG"
      info "created $TALKEY_CONFIG from the example"
    else
      : > "$TALKEY_CONFIG"
    fi
  fi
  if grep -qE "^[#[:space:]]*${key}=" "$TALKEY_CONFIG"; then
    # Rewrite in place, commented-out example lines included - that is where the
    # setting is documented, so the value belongs there rather than appended
    # somewhere else in the file saying the opposite.
    sed -i -E "s|^[#[:space:]]*${key}=.*|${key}=${val}|" "$TALKEY_CONFIG"
  else
    printf '%s=%s\n' "$key" "$val" >> "$TALKEY_CONFIG"
  fi
  ok "$key=$val"
}

# ===========================================================================
# deps
# ===========================================================================
step_deps() {
  step "checking what is installed"
  local missing=()
  # eww, inotifywait and jq are the HUD, and the HUD is not a bonus - without it
  # you dictate blind. Same list as the package's depends.
  for c in ffmpeg paplay xdotool xset curl eww inotifywait jq xev; do
    have "$c" || missing+=("$c")
  done
  if (( ${#missing[@]} )); then
    warn "missing, and dictation will not work without them: ${missing[*]}"
    die "$(pkg_hint "${missing[@]}")"
  fi
  ok "core tools present"

  local soft=()
  have python3    || soft+=("python (live text in the HUD as you speak)")
  have notify-send|| soft+=("libnotify (desktop notifications)")
  have ollama     || soft+=("ollama (names recordings after what you said)")
  if (( ${#soft[@]} )); then
    info "optional, everything still dictates without them:"
    printf '     %s\n' "${soft[@]}"
  fi
}

# ===========================================================================
# model
# ===========================================================================
# Sizes are the real download, not the parameter count. The tradeoff that
# matters: turbo is much better on accented or disfluent speech but wants a GPU,
# and it dropped whisper's translate task, which only the small multilingual
# model still has.
MODELS=(
  "large-v3-turbo|1.6 GB|best accuracy, multilingual. Slow on CPU - wants a GPU"
  "small|466 MB|decent, multilingual, and the only one here that can translate"
  "small.en|466 MB|English only, comfortable on CPU"
  "base.en|142 MB|English only, fastest, noticeably rougher"
)

installed_models() {
  local f
  for f in "$MODEL_DIR"/ggml-*.bin /usr/share/whisper.cpp-model-*/ggml-*.bin; do
    [[ -f "$f" ]] || continue
    printf '%s\n' "$f"
  done
}

# Whether THIS model is where the server will look. installed_models answers
# "is there any model at all", which is the wrong question before starting a
# server that loads one specific file - same probe order as
# bin/talkey-whisper-server, so the two cannot disagree.
model_path() {  # model_path <name> -> path on stdout, 1 if absent
  local name="$1" c
  if [[ -n "${TALKEY_MODEL:-}" ]]; then
    [[ -f "$TALKEY_MODEL" ]] && { printf '%s\n' "$TALKEY_MODEL"; return 0; }
    return 1
  fi
  for c in "$MODEL_DIR/ggml-$name.bin" "/usr/share/whisper.cpp-model-$name/ggml-$name.bin"; do
    [[ -f "$c" ]] && { printf '%s\n' "$c"; return 0; }
  done
  return 1
}

# whisper-server takes one model file, as a path, fixed when it starts - there is
# no registry to pull from and no way to name a model per request. So the file
# has to exist before talkey starts anything, and getting it is an install: your
# package manager, or a download you chose to run. Not talkey's to do for you.
# This prints the ways in and gets out of the way.
model_howto() {  # model_howto <name>
  local name="$1"
  printf '\n   %sHow to get it - pick whichever suits you:%s\n\n' "$B" "$R"
  if have pacman; then
    printf '     from the AUR:\n'
    printf '       whisper.cpp-model-%s\n\n' "$name"
  fi
  printf '     the official whisper.cpp downloader, from a whisper.cpp checkout:\n'
  printf '       bash models/download-ggml-model.sh %s %s\n\n' "$name" "$MODEL_DIR"
  printf '     or straight from the model repo:\n'
  printf '       curl -fL --create-dirs -o %s/ggml-%s.bin \\\n' "$MODEL_DIR" "$name"
  printf '         https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-%s.bin\n\n' "$name"
  printf '     whisper.cpp: https://github.com/ggml-org/whisper.cpp\n'
  printf '     models:      https://huggingface.co/ggerganov/whisper.cpp\n\n'
}

step_model() {
  step "speech model"
  local have_list
  have_list="$(installed_models)"
  if [[ -n "$have_list" ]]; then
    ok "already there:"
    while IFS= read -r f; do printf '     %s\n' "$f"; done <<<"$have_list"
    ask_yn "pick a different one?" n || return 0
  else
    info "talkey needs one. Nothing transcribes without it."
  fi

  local labels=() m name size desc
  for m in "${MODELS[@]}"; do
    IFS='|' read -r name size desc <<<"$m"
    labels+=("$name  ($size) - $desc")
  done
  labels+=("decide later")

  local pick
  pick="$(choose "which model do you want to use?" "${labels[@]}")"
  (( pick > ${#MODELS[@]} )) && {
    info "nothing written - set TALKEY_MODEL_NAME when you have one"
    todo "install a speech model, then: talkey-setup model"
    return 0
  }
  IFS='|' read -r name size desc <<<"${MODELS[$((pick-1))]}"

  # Always written, and exported: step_service runs in this same process and
  # checks for this model, and writing it only when it differs from the default
  # meant re-picking the default silently left the previous choice in place.
  config_set TALKEY_MODEL_NAME "$name"
  export TALKEY_MODEL_NAME="$name"

  local p
  if p="$(model_path "$name")"; then
    ok "already there: $p"
    return 0
  fi

  model_howto "$name"
  info "talkey looks in $MODEL_DIR and /usr/share/whisper.cpp-model-*"
  info "somewhere else? set TALKEY_MODEL to the full path of the .bin"

  # Waiting here rather than marching on to start a server with no model to
  # load. That server exits at once, systemd restarts it until it hits the
  # start limit, and the next step spends 60 seconds printing dots at a unit
  # that stopped trying seconds in.
  printf '\n   Run one of those now, in another terminal - this waits.\n'
  while true; do
    read -r -p "   Enter to check again, or 's' to skip: " a
    if [[ "${a,,}" == s ]]; then
      todo "install the $name model ($size) - the ways in are above, or re-run: talkey-setup model"
      info "skipped - the speech service needs it, so that is left too"
      return 1
    fi
    if p="$(model_path "$name")"; then ok "found $p"; return 0; fi
    warn "not there yet: $MODEL_DIR/ggml-$name.bin"
  done
}

# ===========================================================================
# service
# ===========================================================================
step_service() {
  step "speech-to-text service"
  if ! have systemctl; then
    warn "no systemd - start the server yourself: talkey-whisper-server"
    return 0
  fi
  local unit=talkey-whisper.service
  if ! systemctl --user cat "$unit" >/dev/null 2>&1; then
    warn "$unit is not installed"
    info "from a checkout, run setup/install.sh - it installs the units"
    todo "install the systemd units: run setup/install.sh from a talkey checkout"
    return 1
  fi

  # Someone pointing at their own server has no model and no unit of ours to
  # care about, so neither check applies to them.
  if [[ -z "${TALKEY_WHISPER_URL:-}" ]] && ! model_path "${TALKEY_MODEL_NAME:-large-v3-turbo}" >/dev/null; then
    warn "no ${TALKEY_MODEL_NAME:-large-v3-turbo} model, so the server would exit as soon as it started"
    info "get the model first: talkey-setup model"
    todo "install a speech model, then: talkey-setup service"
    return 1
  fi

  if systemctl --user is-active --quiet "$unit"; then
    ok "already running"
  else
    ask_yn "start it now, and at every login?" || {
      info "skipped"
      todo "start the speech service: systemctl --user enable --now $unit"
      return 0
    }
    # An earlier start with no model can leave the unit rate-limited, and it
    # will not come back until the failure count is cleared.
    systemctl --user reset-failed "$unit" 2>/dev/null || true
    systemctl --user enable --now "$unit" || {
      warn "could not start $unit"
      todo "start the speech service: systemctl --user enable --now $unit"
      return 1
    }
  fi

  # A 1.6GB model off cold cache takes far longer than a second to load, so a
  # single immediate check would report a fault that is not there.
  local host="${TALKEY_WHISPER_HOST:-127.0.0.1}" port="${TALKEY_WHISPER_PORT:-8910}"
  printf '   %s-%s waiting for the server on %s:%s ' "$DIM" "$R" "$host" "$port"
  local up=0 dead=0 _
  for _ in $(seq 1 60); do
    if curl -sS --max-time 2 -o /dev/null "http://$host:$port/" 2>/dev/null; then up=1; break; fi
    # Stop the moment the unit gives up. Waiting out the full minute at a
    # service that already died just delays the bad news by 50 seconds.
    if ! systemctl --user is-active --quiet "$unit"; then dead=1; break; fi
    printf '.'; sleep 1
  done
  printf '\n'
  if (( up )); then
    ok "responding on $host:$port"
    return 0
  fi
  if (( dead )); then
    warn "the service stopped. Its last words:"
  else
    warn "no answer within 60s. The service is running but not answering:"
  fi
  # Printed here rather than named as a command to go and run - the reason is
  # usually one line, and it is the whole point of this step.
  journalctl --user -u "$unit" -n 5 --no-pager -o cat 2>/dev/null | sed 's/^/     /'
  todo "the speech server is not answering on $host:$port - fix what it says above, then: systemctl --user restart $unit"
  return 1
}

# ===========================================================================
# keys
# ===========================================================================
# xev opens its own window and reports only what is typed while that window has
# focus, so this never sees keystrokes meant for anything else. xdotool focuses
# it for you.
# Only the keycode goes to stdout - the caller reads it from there. Everything
# a human reads goes to stderr, or it would be captured as the value.
capture_keycode() {  # capture_keycode "role" -> keycode on stdout, empty if skipped
  local role="$1" out wid code="" _
  out="$(mktemp)"; : > "$out"
  xev -event keyboard > "$out" 2>/dev/null &
  local xevpid=$!
  for _ in $(seq 1 30); do
    wid="$(xdotool search --name '^Event Tester$' 2>/dev/null | head -1)"
    [[ -n "$wid" ]] && break
    sleep 0.1
  done
  if [[ -z "$wid" ]]; then
    kill "$xevpid" 2>/dev/null; rm -f "$out"
    warn "xev did not open a window"
    return 1
  fi
  xdotool windowactivate --sync "$wid" 2>/dev/null
  printf '   press the key for %s%s%s (15s, or wait to keep the current one) ' "$B" "$role" "$R" >&2
  for _ in $(seq 1 150); do
    code="$(grep -A3 '^KeyPress' "$out" 2>/dev/null | grep -oP 'keycode\s+\K[0-9]+' | head -1)"
    [[ -n "$code" ]] && break
    sleep 0.1
  done
  kill "$xevpid" 2>/dev/null; wait "$xevpid" 2>/dev/null
  rm -f "$out"
  [[ -n "$code" ]] || { printf 'skipped\n' >&2; return 1; }
  printf 'keycode %s\n' "$code" >&2
  printf '%s\n' "$code"
}

# The bindings file keeps every keycode in `set $key_* NNN` lines at the top,
# specifically so only those lines ever need rewriting.
# --- what is already bound -------------------------------------------------
# Capturing a key that another binding already owns produces the failure that
# looks most like talkey being broken: the key does something, just not this.
# i3 resolves includes, so the scan has to as well.
i3_config_files() {
  local main="$1" line inc
  [[ -f "$main" ]] || return 0
  printf '%s\n' "$main"
  while read -r line; do
    inc="${line#*include }"; inc="${inc%%#*}"; inc="${inc//\"/}"
    inc="${inc#"${inc%%[![:space:]]*}"}"; inc="${inc%"${inc##*[![:space:]]}"}"
    [[ "$inc" == talkey.conf || "$inc" == *"/talkey.conf" ]] && continue  # ours
    [[ "$inc" == '~'* ]] && inc="$HOME${inc#\~}"
    [[ "$inc" != /* ]] && inc="$(dirname "$main")/$inc"
    [[ -f "$inc" ]] && printf '%s\n' "$inc"
  done < <(grep -hE '^[[:space:]]*include[[:space:]]' "$main" 2>/dev/null)
}

# Prints "file:line: the offending line" for anything already bound to this
# keycode, so the report can name where to go and change it.
keycode_conflict() {  # keycode_conflict <code> <i3cfg>
  local code="$1" cfg="$2" f
  while read -r f; do
    grep -nE "^[[:space:]]*bindcode([[:space:]]+--[a-z-]+)*[[:space:]]+${code}\b" "$f" 2>/dev/null \
      | sed "s|^|${f}:|"
  done < <(i3_config_files "$cfg")
}

# A role with no keycode is commented out rather than left holding a number
# nobody pressed. Every line mentioning the variable has to go, not just the
# `set`: i3 does not substitute an undefined variable, so a surviving
# `bindcode $key_memo` is a config error on reload. \b does not match before
# an underscore, so $key_dictate never catches $key_dictate_alt.
write_i3_bindings() {  # write_i3_bindings <dest> <dictate> <alt> <memo> <submit>
  local dest="$1" src="$DATA_DIR/bindings/i3.conf"
  [[ -f "$src" ]] || { warn "missing $src"; return 1; }
  local -A val=([key_dictate]="$2" [key_dictate_alt]="$3" [key_memo]="$4" [key_submit]="$5")
  local tmp v args=()
  tmp="$(mktemp)"
  for v in key_dictate key_dictate_alt key_memo key_submit; do
    if [[ -n "${val[$v]}" ]]; then
      args+=(-e "s|^set \\\$$v .*|set \$$v ${val[$v]}|")
    else
      args+=(-e "/^[^#].*\\\$$v\\b/s|^|# unbound by talkey-setup: |")
    fi
  done
  sed -E "${args[@]}" "$src" > "$tmp"

  # One line names every key at once - the watcher that keeps auto-repeat off.
  # The rule above would comment it out for mentioning an unbound variable,
  # taking the bound keys' protection with it, so rebuild it from what is left.
  local bound=()
  for v in key_dictate key_dictate_alt key_memo key_submit; do
    [[ -n "${val[$v]}" ]] && bound+=("\$$v")
  done
  if (( ${#bound[@]} )); then
    sed -i -E "s|^(# unbound by talkey-setup: )?exec_always --no-startup-id talkey-norepeat .*|exec_always --no-startup-id talkey-norepeat ${bound[*]}|" "$tmp"
  fi

  mv -f "$tmp" "$dest"
  ok "wrote $dest"
}

# Reloading is the difference between "written" and "live". i3-msg reports
# failures as JSON with "success":false rather than a non-zero exit, so the
# output is what has to be read.
i3_reload() {
  have i3-msg || { info "reload i3 (Mod+Shift+R) to load the bindings"; return 0; }
  local out
  out="$(i3-msg -t command reload 2>&1)"
  if [[ "$out" == *'"success":true'* ]]; then
    ok "i3 reloaded - your keys are live now"
  else
    warn "i3 would not reload: $out"
    todo "reload i3 (Mod+Shift+R) - the keys do nothing until you do"
  fi
}

step_keys() {
  step "key bindings"
  if ! have xev; then
    warn "xev is not installed, so keys cannot be read from the keyboard"
    info "$(pkg_hint xev) - then re-run: talkey-setup keys"
    info "or type the numbers in below; 'xmodmap -pke' lists them"
  fi

  local wm="" pick
  if pgrep -x i3 >/dev/null 2>&1; then
    wm=i3; ok "i3 is running"
  else
    pick="$(choose "which do you use for key bindings?" \
      "i3" "sxhkd" "xbindkeys" "none of these - just show me the keycodes")"
    case "$pick" in 1) wm=i3 ;; 2) wm=sxhkd ;; 3) wm=xbindkeys ;; 4) wm=none ;; esac
  fi

  # Seeded from a previous run, never from built-in numbers. The defaults in
  # bindings/i3.conf are a Keychron K10's media keys - right for the machine
  # this was written on and wrong for nearly everyone - so offering to "keep"
  # them would quietly bind four keys the user does not have, and report them
  # as chosen. A role nobody presses stays empty and gets commented out.
  local dest="${XDG_CONFIG_HOME:-$HOME/.config}/i3/talkey.conf"
  local -A code=([dictate]="" [dictate_alt]="" [memo]="" [submit]="")
  local role prev CAPS_CHOSEN=0

  local i3cfg="" c
  for c in "${XDG_CONFIG_HOME:-$HOME/.config}/i3/config" "$HOME/.i3/config"; do
    [[ -f "$c" ]] && { i3cfg="$c"; break; }
  done
  if [[ -f "$dest" ]]; then
    for role in dictate dictate_alt memo submit; do
      prev="$(sed -nE "s|^set \\\$key_$role ([0-9]+).*|\1|p" "$dest" | head -1)"
      [[ -n "$prev" ]] && code[$role]="$prev"
    done
    [[ -n "${code[dictate]}" ]] && info "found your current keys in $dest - press Enter at a prompt to keep one"
  fi

  # Caps Lock is the one key that is on every keyboard, reachable without
  # moving your hand, and doing nothing anybody needs. Nothing else is
  # universal: media keys vary, Menu is missing on laptops and Macs, Scroll
  # Lock and Pause are absent from anything compact. So it is the only default
  # offered, and only for dictate - submit and memo have no universal home, and
  # inventing one would bind a key the user does have to something else.
  local CAPS=66
  if [[ -z "${code[dictate]}" ]]; then
    printf '\n'
    info "Caps Lock can be your dictate key: hold it to talk, release to type."
    info "It is on every keyboard, and this stops it being Caps Lock."
    local conf
    conf="$(keycode_conflict "$CAPS" "${i3cfg:-/nonexistent}")"
    if [[ -n "$conf" ]]; then
      warn "something already binds Caps Lock:"
      printf '     %s\n' "$conf"
      info "pressing your own key below avoids the clash"
    elif ask_yn "use Caps Lock for dictate?"; then
      code[dictate]="$CAPS"
      CAPS_CHOSEN=1
      ok "dictate is Caps Lock"
      info "it will stop capitalising - 'setxkbmap -option' with no argument undoes that"
    fi
  fi

  local -A prompt=(
    [dictate]="dictate - hold to talk"
    [submit]="submit - send / Enter"
    [memo]="memo - translate toggle, double-tap restart, hold for a memo"
    [dictate_alt]="dictate in a second language (optional)"
  )
  local got
  for role in dictate submit memo dictate_alt; do
    while true; do
      if have xev; then
        # Announced before xev takes the focus - once the Event Tester window is
        # up, the prompt is behind it and nobody is reading this line.
        printf '\n   %s%s%s\n' "$B" "${prompt[$role]}" "$R"
        [[ -n "${code[$role]}" ]] && info "currently ${code[$role]}"
        got="$(capture_keycode "${prompt[$role]}")" || got=""
      else
        read -r -p "   keycode for ${prompt[$role]} [${code[$role]:-none}]: " got
        [[ "$got" =~ ^[0-9]+$ ]] || got=""
      fi
      if [[ -n "$got" ]]; then
        # Say so before writing it. A key that already does something else is
        # the fault that looks most like talkey being broken - it reacts, just
        # not the way you meant.
        local conf
        conf="$(keycode_conflict "$got" "${i3cfg:-/nonexistent}")"
        if [[ -n "$conf" ]]; then
          warn "keycode $got is already bound:"
          printf '     %s\n' "$conf"
          ask_yn "use it for $role anyway? (comment that line out, or it wins)" n || continue
        fi
        code[$role]="$got"; break
      fi
      # Nothing pressed. Only an offer to keep if there is something to keep.
      if [[ -n "${code[$role]}" ]]; then info "kept ${code[$role]}"; break; fi
      if [[ "$role" == dictate_alt ]]; then info "left unbound - you only dictate in one language"; break; fi
      ask_yn "nothing pressed - try $role again?" || { info "$role left unbound"; break; }
    done
  done

  printf '\n'
  if [[ -z "${code[dictate]}" ]]; then
    warn "no dictate key, so there is nothing to write - that is the one key talkey needs"
    todo "bind your keys: talkey-setup keys"
    return 1
  fi
  info "dictate=${code[dictate]:-unbound} submit=${code[submit]:-unbound} memo=${code[memo]:-unbound} alt=${code[dictate_alt]:-unbound}"

  # talkey-norepeat needs the same codes, and a systemd unit has no argument
  # list - so they have to live in the config for the non-i3 paths to work.
  # Only the keys that exist: an empty slot would pass a blank argument.
  local codes=()
  for role in dictate dictate_alt memo submit; do
    [[ -n "${code[$role]}" ]] && codes+=("${code[$role]}")
  done
  config_set TALKEY_NOREPEAT_KEYCODES "${codes[*]}"

  case "$wm" in
    i3)
      if [[ -f "$dest" ]]; then
        ask_yn "$dest exists - overwrite it?" n || { info "left it alone"; return 0; }
        cp -f "$dest" "$dest.bak"; info "kept a copy at $dest.bak"
      fi
      mkdir -p "$(dirname "$dest")"
      write_i3_bindings "$dest" "${code[dictate]}" "${code[dictate_alt]}" \
        "${code[memo]}" "${code[submit]}" || return 1

      # Holding Caps Lock would otherwise toggle the Lock modifier and put
      # everything talkey types in capitals. Written into our own file so it
      # applies for the session and is undone by removing the include.
      if (( CAPS_CHOSEN )); then
        printf '\n# Caps Lock is your dictate key, so stop it latching capitals.\n' >> "$dest"
        printf '# Undo by deleting this line: it only lasts as long as the session.\n' >> "$dest"
        printf 'exec_always --no-startup-id setxkbmap -option caps:none\n' >> "$dest"
        ok "Caps Lock will no longer capitalise"
      fi

      # i3 does not read the file until it is included, and a file that is never
      # included behaves exactly like a broken install - every key does nothing,
      # with nothing to tell the two apart. So offer, rather than print a line
      # and hope. i3's own parser gets the veto, and a rejected edit is rolled
      # straight back.
      if [[ -n "$i3cfg" ]] && grep -qE "^[[:space:]]*include[[:space:]]+.*talkey\.conf" "$i3cfg"; then
        ok "already included from $i3cfg"
        i3_reload
      elif [[ -z "$i3cfg" ]]; then
        warn "no i3 config found, so nothing can include the bindings"
        todo "add 'include ${dest/#$HOME/\~}' to your i3 config, then reload i3"
      elif ask_yn "add 'include ${dest/#$HOME/\~}' to $i3cfg now?"; then
        cp -f "$i3cfg" "$i3cfg.talkey.bak"
        printf '\n# talkey key bindings\ninclude %s\n' "$dest" >> "$i3cfg"
        if i3 -C -c "$i3cfg" >/dev/null 2>&1; then
          ok "added, and i3 accepts it (kept a copy at $i3cfg.talkey.bak)"
          i3_reload
        else
          cp -f "$i3cfg.talkey.bak" "$i3cfg"
          warn "i3 rejected the result, so your config was put back exactly as it was:"
          i3 -C -c "$i3cfg.talkey.bak" >/dev/null 2>&1 \
            && printf '     the problem is in %s\n' "$dest" \
            || printf '     your config already had an error before talkey touched it\n'
          todo "add 'include ${dest/#$HOME/\~}' to $i3cfg by hand, then reload i3"
        fi
      else
        printf '\n   %sOne line left, in %s:%s\n\n' "$B" "$i3cfg" "$R"
        printf '     include %s\n\n' "${dest/#$HOME/\~}"
        info "the keys do nothing until you add it, then reload i3 (Mod+Shift+R)"
        todo "add 'include ${dest/#$HOME/\~}' to $i3cfg, then reload i3 (Mod+Shift+R)"
      fi
      ;;
    sxhkd|xbindkeys)
      local src="$DATA_DIR/bindings/sxhkdrc"
      [[ "$wm" == xbindkeys ]] && src="$DATA_DIR/bindings/xbindkeysrc"
      printf '\n   %s%s uses its own format - start from:%s\n' "$B" "$wm" "$R"
      printf '     %s\n' "$src"
      info "put the keycodes above into it, then start the helpers:"
      info "  systemctl --user enable --now talkey-hud talkey-norepeat"
      ;;
    none)
      info "your keycodes are above - bind them however you like"
      ;;
  esac
}

# ===========================================================================
main() {
  local what="${1:-all}"
  case "$what" in
    -h|--help|help)
      # Every comment line after the shebang, up to the first line of code. A
      # fixed line range used to cut the list off at `keys`, hiding `service` -
      # the one subcommand that recovers a failed run.
      awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$(readlink -f "$0")"
      exit 0 ;;
    all|model|service|keys)
      # These ask questions. Run blind - a pacman hook, a script - they would
      # either hang on a read or silently take defaults nobody chose.
      [[ -t 0 ]] || die "'$what' is interactive - run it in a terminal" ;;
  esac
  case "$what" in
    all)     step_deps; step_model; step_service; step_keys ;;
    model)   step_model ;;
    service) step_service ;;
    keys)    step_keys ;;
    deps)    step_deps ;;
    *) die "unknown step '$what' - try: all, model, service, keys, deps" ;;
  esac
  # The ending reports what actually happened. Anything a step could not finish
  # is listed, in the order it has to be done, with the command that fixes it.
  local cfg="${TALKEY_CONFIG/#$HOME/\~}"
  if (( ${#TODO[@]} )); then
    printf '\n%snot ready yet.%s %d thing%s left before you can dictate:\n\n' \
      "$B" "$R" "${#TODO[@]}" "$( (( ${#TODO[@]} == 1 )) || printf s )"
    local i=1 t
    for t in "${TODO[@]}"; do printf '  %d) %s\n' "$i" "$t"; i=$((i+1)); done
    printf '\nthen run talkey-setup again - it checks every one of these.\n'
    printf 'stuck? %stalkey doctor%s checks the whole chain and says what to do.\n' "$B" "$R"
    printf 'settings live in %s\n' "$cfg"
    return 1
  fi
  if [[ "$what" == all ]]; then
    printf '\n%sdone.%s hold your dictate key, speak, release.\n' "$B" "$R"
    printf 'settings live in %s - talkey-setup keys rebinds later.\n' "$cfg"
  fi
}

main "$@"
