#!/usr/bin/env bash
# Key cheat-sheet for talkey, shown in the overlay window (`talkey help`).
# Stays open until toggled off via the key; the sleep is a safety auto-close
# (the overlay is no-focus, so it can't take a keypress to dismiss itself).
#
# The key NAMES here are labels only - they bind nothing. Set them to whatever
# is printed on your keyboard so the sheet matches the keys your fingers find.
# The defaults describe a Keychron K10's media keys, which is also what
# i3/talkey.conf binds by default.
set -u
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
for _l in "$SCRIPT_DIR/../lib" /usr/share/talkey/lib; do
  [[ -f "$_l/common.sh" ]] && { . "$_l/common.sh"; break; }
done

DUR="${TALKEY_HELP_SECONDS:-120}"
L_DICTATE="${TALKEY_LABEL_DICTATE:-●}"               # the main dictate key
L_DICTATE2="${TALKEY_LABEL_DICTATE2:-Tools}"         # the second-language key
L_SUBMIT="${TALKEY_LABEL_SUBMIT:-⏎ Triangle}"        # the submit/cancel key
L_MEMO="${TALKEY_LABEL_MEMO:-■ Square}"              # the memo/translate key
LANG1="${TALKEY_LABEL_LANG:-English}"                # your main dictation language
LANG2="${TALKEY_LABEL_LANG2:-Dutch}"                 # the second language

C=$'\e[38;5;44m'; B=$'\e[1m'; D=$'\e[2m'; R=$'\e[0m'
G=$'\e[38;5;42m'; RED=$'\e[38;5;203m'; CY=$'\e[38;5;44m'

printf '\e[2J\e[H\e[?25l'
trap 'printf "\e[0m\e[?25h"' EXIT

cat <<EOF

  ${C}${B}talkey - keys${R}

  ${CY}${B}${L_DICTATE}${R}          dictate ${D}(${LANG1})${R}
  ${CY}${B}${L_DICTATE2}${R}      dictate ${D}(${LANG2})${R}
  ${G}${B}${L_SUBMIT}${R}  send after dictation finishes ${D}(Enter)${R}
  ${RED}${B}${L_MEMO}${R}    tap = translate to EN ${D}· double-tap = restart · else memo (hold=rec, release=play)${R}

  ${D}hold a dictate key = talk while held${R}
  ${D}tap it = hands-free (tap again to stop)${R}
  ${D}tap ${L_SUBMIT} mid-dictation = send when it finishes${R}
  ${D}double-tap ${L_MEMO} mid-dictation = discard and record again${R}
EOF

sleep "$DUR"
