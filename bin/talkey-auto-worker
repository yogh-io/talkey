#!/usr/bin/env python3
"""Continuous 16 kHz capture, Silero VAD and ordered dictation delivery.

Silero uses the standard library and whisper.cpp. Optional Smart Turn uses
NumPy and ONNX Runtime to distinguish a thinking pause from a completed turn.
Capture continues into a bounded queue during final inference and desktop output.
"""
import argparse
from array import array
from collections import deque
from concurrent.futures import ThreadPoolExecutor
import ctypes as C
import ctypes.util
import json
import math
import os
from pathlib import Path
import queue
import signal
import subprocess
import sys
import threading
import time

FRAME_SAMPLES = 512
FRAME_MS = 32
FRAME_BYTES = FRAME_SAMPLES * 2

for data in (Path(os.environ.get('TALKEY_DATA_DIR', '/nonexistent')),
             Path(__file__).resolve().parent.parent, Path('/usr/share/talkey')):
    if (data / 'lib/speech.py').is_file():
        sys.path.insert(0, str(data / 'lib'))
        break
from speech import strip_end_cue, transcribe


def setting(name, default, minimum, maximum):
    value = float(os.environ.get('TALKEY_' + name, default))
    if not math.isfinite(value) or not minimum <= value <= maximum:
        raise ValueError(f'TALKEY_{name} must be between {minimum} and {maximum}')
    return value


class VadParams(C.Structure):
    _fields_ = [('n_threads', C.c_int), ('use_gpu', C.c_bool), ('gpu_device', C.c_int)]


class Silero:
    """Use whisper.cpp's C API; older releases use a rolling context window."""
    def __init__(self):
        home = Path.home()
        opt = Path(os.environ.get('WHISPER_OPT', home / '.local/opt/whisper.cpp'))
        override = os.environ.get('TALKEY_WHISPER_LIB')
        local = opt / 'build/bin/libwhisper.so'
        library = override or (str(local) if local.exists() else C.util.find_library('whisper'))
        if not library:
            raise ValueError('libwhisper not found; set TALKEY_WHISPER_LIB to libwhisper.so')
        model = os.environ.get('TALKEY_VAD_MODEL')
        if not model:
            for directory in (Path(os.environ.get('WHISPER_MODEL_DIR', home / '.local/share/whisper')),
                              opt / 'models', Path('/usr/share/whisper.cpp-model-silero-v5.1.2')):
                candidate = directory / 'ggml-silero-v5.1.2.bin'
                if candidate.is_file():
                    model = str(candidate)
                    break
        if not model or not Path(model).is_file():
            raise ValueError('Silero model missing; run talkey-setup vad for download instructions')
        self.lib = C.CDLL(library)
        lib = self.lib
        # VAD otherwise logs several INFO lines for every 32 ms audio frame.
        self.log_callback = C.CFUNCTYPE(None, C.c_int, C.c_char_p, C.c_void_p)(
            lambda level, message, _: print(message.decode(errors='replace'), end='', file=sys.stderr)
            if level >= 3 else None)
        lib.whisper_log_set.argtypes = [type(self.log_callback), C.c_void_p]
        lib.whisper_log_set(self.log_callback, None)
        try:
            lib.whisper_vad_default_context_params.restype = VadParams
            lib.whisper_vad_init_from_file_with_params.argtypes = [C.c_char_p, VadParams]
            lib.whisper_vad_init_from_file_with_params.restype = C.c_void_p
            lib.whisper_vad_n_probs.argtypes = [C.c_void_p]
            lib.whisper_vad_n_probs.restype = C.c_int
            lib.whisper_vad_probs.argtypes = [C.c_void_p]
            lib.whisper_vad_probs.restype = C.POINTER(C.c_float)
            lib.whisper_vad_free.argtypes = [C.c_void_p]
            lib.whisper_vad_free.restype = None
            self.streaming = hasattr(lib, 'whisper_vad_detect_speech_no_reset')
            self.detect = (lib.whisper_vad_detect_speech_no_reset if self.streaming
                           else lib.whisper_vad_detect_speech)
            self.detect.argtypes = [C.c_void_p, C.POINTER(C.c_float), C.c_int]
            self.detect.restype = C.c_bool
        except AttributeError as error:
            raise ValueError('whisper.cpp library lacks VAD support; upgrade whisper.cpp') from error
        params = lib.whisper_vad_default_context_params()
        params.n_threads, params.use_gpu = 1, False
        self.context = lib.whisper_vad_init_from_file_with_params(os.fsencode(model), params)
        if not self.context:
            raise ValueError(f'could not load VAD model: {model}')
        if self.streaming:
            lib.whisper_vad_reset_state.argtypes = [C.c_void_p]
            lib.whisper_vad_reset_state.restype = None
            lib.whisper_vad_reset_state(self.context)
        self.history = deque(maxlen=32)
        self.threshold = setting('VAD_THRESHOLD', '0.5', 0.01, 0.99)

    def speech(self, frame):
        samples = array('h', frame)
        if sys.byteorder != 'little':
            samples.byteswap()
        self.history.append(samples)
        values = samples if self.streaming else [v for chunk in self.history for v in chunk]
        audio = (C.c_float * len(values))(*(v / 32768.0 for v in values))
        if not self.detect(self.context, audio, len(values)):
            raise RuntimeError('VAD inference failed')
        count = self.lib.whisper_vad_n_probs(self.context)
        if count < 1:
            raise RuntimeError('VAD returned no probabilities')
        return self.lib.whisper_vad_probs(self.context)[count - 1] >= self.threshold

    def close(self):
        self.lib.whisper_vad_free(self.context)


class Endpoint:
    """Debounce speech onset and tolerate pauses; times use audio, not inference."""
    def __init__(self, start_ms=160, silence_ms=1200, max_ms=900000, wait_ms=None):
        self.start_frames = math.ceil(start_ms / FRAME_MS)
        self.silence_frames = math.ceil(silence_ms / FRAME_MS)
        self.max_frames = math.ceil(max_ms / FRAME_MS)
        self.wait_frames = math.ceil(wait_ms / FRAME_MS) if wait_ms is not None else self.silence_frames
        self.reset()

    def reset(self):
        self.active = False
        self.voiced = self.quiet = self.length = 0

    def update(self, speech):
        if not self.active:
            self.voiced = self.voiced + 1 if speech else 0
            if self.voiced >= self.start_frames:
                self.active = True
                self.length = self.voiced
                return 'start'
        else:
            self.length += 1
            self.quiet = 0 if speech else self.quiet + 1
            if self.quiet >= self.wait_frames or self.length >= self.max_frames:
                self.reset()
                return 'end'
            if self.quiet == self.silence_frames:
                return 'pause'
        return None


class StopRequested(Exception):
    pass


def stop_requested(*_):
    raise StopRequested()


class EndCue:
    def __init__(self, phrase):
        self.phrase = phrase

    def matches(self, pcm):
        text = transcribe(pcm, os.environ.get('TALKEY_WHISPER_URL', 'http://127.0.0.1:8910/inference'),
                          os.environ.get('TALKEY_LANG', 'en'), self.phrase, 16000, 1)
        if strip_end_cue(text, self.phrase) is not None:
            return True
        if os.environ.get('TALKEY_COMMANDS', '0') == '1':
            from commands import resolve
            config = Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config'))
            user = Path(os.environ.get('TALKEY_COMMANDS_DIR', config / 'talkey/commands.d'))
            return resolve(text, data, user)['kind'] in ('builtin', 'exec')
        return False


class Listener:
    def __init__(self, vad, turn=None):
        self.vad = vad
        self.turn = turn
        self.run_dir = Path(os.environ['TALKEY_AUTO_RUN'])
        self.state_dir = Path(os.environ['TALKEY_STATE_DIR'])
        self.command = str(Path(__file__).resolve().with_name('talkey'))
        start = setting('VAD_START_MS', '160', 32, 2000)
        silence = setting('VAD_SILENCE_MS', '1200', 160, 10000)
        cap = setting('MAX_REC_S', '900', 1, 86400)
        self.turn_min_ms = setting('TURN_MIN_SILENCE_MS', '2000', 160, 60000)
        self.turn_wait_ms = setting('TURN_MAX_SILENCE_MS', '20000', 160, 120000)
        self.turn_threshold = setting('TURN_THRESHOLD', '0.9', .01, .99)
        self.endpoint = Endpoint(start, silence, cap * 1000, self.turn_wait_ms if turn else None)
        # Retain the speech context while waiting, but do not feed an ever-longer
        # silent tail into the model. That would replace the words with silence.
        self.turn_audio = deque(maxlen=math.ceil((8000 + self.turn_wait_ms) / FRAME_MS))
        self.executor = ThreadPoolExecutor(max_workers=1) if turn else None
        self.prediction = None
        self.revision = 0
        self.checked_revision = -1
        self.prediction_revision = -1
        self.probability = None
        self.display_state = None
        phrase = os.environ.get('TALKEY_END_PHRASE', '').strip()
        if phrase and strip_end_cue(phrase, phrase) is None:
            raise ValueError('TALKEY_END_PHRASE must contain words')
        self.cue = EndCue(phrase) if phrase or os.environ.get('TALKEY_COMMANDS', '0') == '1' else None
        self.cue_executor = ThreadPoolExecutor(max_workers=1) if self.cue else None
        self.cue_audio = deque(maxlen=math.ceil(8000 / FRAME_MS))
        self.cue_prediction = None
        self.cue_checked_revision = self.cue_prediction_revision = -1
        self.cue_matched_revision = -1
        self.cue_quiet_frames = math.ceil(setting('END_PHRASE_SILENCE_MS', '600', 160, 10000) / FRAME_MS)
        self.idle_seconds = setting('AUTO_IDLE_S', '120', 0, 86400)
        # Include all onset frames plus 300 ms before them.
        self.preroll = deque(maxlen=math.ceil((start + 300) / FRAME_MS))
        self.frames = queue.Queue(maxsize=math.ceil(120000 / FRAME_MS))
        self.capture_error = None
        self.overflow = False
        self.capture = None
        self.take = self.output = None
        self.stopping = threading.Event()

    def state(self, value):
        # auto stop owns the off state, including while a finalizer is running.
        if (self.run_dir / 'state').read_text().strip() == 'off':
            raise StopRequested()
        if self.display_state == value:
            return
        self.display_state = value
        tmp = self.run_dir / 'state.tmp'
        tmp.write_text(value + '\n')
        tmp.replace(self.run_dir / 'state')
        if self.take and value in ('speaking', 'paused'):
            (self.take / 'dictate.header').write_text(value)
        (self.state_dir / 'session.changed').write_text('changed\n')

    def call(self, action):
        env = dict(os.environ)
        if self.take:
            env['TALKEY_AUTO_TAKE'] = str(self.take)
        # Do not use a Popen context manager: stopping while a finalizer is
        # blocked must not wait for it. The controller cancels that private take.
        child = subprocess.Popen([self.command, '_auto', action], env=env,
                                 stdout=subprocess.PIPE, text=True)
        output, _ = child.communicate()
        if child.returncode:
            raise RuntimeError(f'auto {action} failed ({child.returncode})')
        return output.strip()

    def read_audio(self):
        try:
            while not self.stopping.is_set():
                frame = self.capture.stdout.read(FRAME_BYTES)
                if len(frame) != FRAME_BYTES:
                    raise RuntimeError('microphone stream ended')
                try:
                    self.frames.put_nowait(frame)
                except queue.Full as error:
                    self.overflow = True
                    raise RuntimeError('transcription fell over 120 seconds behind capture') from error
        except Exception as error:
            self.capture_error = error

    def finish(self):
        self.output.close()
        self.output = None
        self.call('finish')
        self.take = None
        self.preroll.clear()
        self.turn_audio.clear()
        self.cue_audio.clear()
        self.endpoint.reset()
        self.revision += 1
        self.probability = None
        self.state('listening')

    def check_cue(self):
        if self.cue_prediction and self.cue_prediction.done():
            prediction = self.cue_prediction
            self.cue_prediction = None
            if self.cue_prediction_revision == self.revision and self.output:
                try:
                    matched = prediction.result()
                except Exception as error:
                    # A failed optional cue check cannot invent an endpoint.
                    print(f'talkey auto: end cue check failed: {error}', file=sys.stderr)
                else:
                    if matched:
                        self.cue_matched_revision = self.revision
        if (self.output and self.cue_matched_revision == self.revision
                and self.endpoint.quiet >= self.cue_quiet_frames and self.frames.empty()):
            self.turn_decision('end_cue')
            self.finish()
            return
        if (self.output and self.endpoint.quiet >= self.cue_quiet_frames
                and self.cue_checked_revision != self.revision and self.cue_prediction is None):
            self.cue_checked_revision = self.cue_prediction_revision = self.revision
            self.cue_prediction = self.cue_executor.submit(self.cue.matches, b''.join(self.cue_audio))

    def turn_decision(self, reason):
        if self.take:
            (self.take / 'turn.json').write_text(json.dumps({
                'reason': reason, 'probability': self.probability,
                'threshold': self.turn_threshold,
            }) + '\n')

    def check_turn(self):
        """Keep consuming audio while inference runs; resumed speech invalidates it."""
        if self.prediction:
            if self.prediction.done():
                prediction = self.prediction
                self.prediction = None
                if self.prediction_revision == self.revision:
                    probability = prediction.result()  # Fail closed on current model errors.
                    if not math.isfinite(probability) or not 0 <= probability <= 1:
                        raise RuntimeError('invalid Smart Turn completion probability')
                    self.probability = probability
                    self.turn_decision('complete' if probability >= self.turn_threshold else 'incomplete')
            elif time.monotonic() - self.prediction_started > 5:
                raise RuntimeError('Smart Turn inference timed out; unfinished audio retained')
        if not self.output or self.endpoint.quiet < self.endpoint.silence_frames:
            return
        self.state('paused')
        if self.checked_revision != self.revision and self.prediction is None:
            self.checked_revision = self.prediction_revision = self.revision
            self.prediction_started = time.monotonic()
            pcm = b''.join(self.turn_audio)
            excess_quiet = max(0, self.endpoint.quiet - math.ceil(500 / FRAME_MS))
            if excess_quiet:
                pcm = pcm[:-excess_quiet * FRAME_BYTES]
            self.prediction = self.executor.submit(self.turn.probability, pcm)
        # Drain already-captured audio before trusting a completion. A queued
        # continuation must not be split just because inference finished first.
        if (self.probability is not None and self.probability >= self.turn_threshold
                and self.endpoint.quiet * FRAME_MS >= self.turn_min_ms
                and self.frames.empty()):
            self.turn_decision('complete')
            self.finish()

    def run(self):
        # Parent publishes the PID/start-time pair before callbacks can begin.
        deadline = time.monotonic() + 5
        while not (self.run_dir / 'worker.pid.start').exists():
            if time.monotonic() > deadline:
                raise RuntimeError('listener identity was not published')
            time.sleep(.01)
        self.capture = subprocess.Popen([
            os.environ.get('TALKEY_FFMPEG', 'ffmpeg'), '-nostdin', '-hide_banner', '-loglevel', 'error',
            '-f', 'pulse', '-i', os.environ.get('TALKEY_SOURCE', 'default'),
            '-ac', '1', '-ar', '16000', '-f', 's16le', '-'], stdout=subprocess.PIPE)
        threading.Thread(target=self.read_audio, daemon=True).start()
        self.state('listening')
        last_frame = time.monotonic()
        last_speech = last_frame
        while True:
            if (self.idle_seconds and not self.output and self.frames.empty()
                    and time.monotonic() - last_speech >= self.idle_seconds):
                self.call('idle')
                return
            if self.output and (self.take / 'finish.requested').exists():
                self.turn_decision('manual')
                self.finish()
            try:
                frame = self.frames.get(timeout=.032)
                last_frame = time.monotonic()
            except queue.Empty:
                if self.capture_error:
                    if self.output and not self.turn:
                        self.finish()
                    raise self.capture_error
                # Some hardware mute switches stop samples instead of sending
                # zeros. Treat a stalled stream as silence after a short grace.
                if time.monotonic() - last_frame < .25 or not self.output:
                    continue
                frame = bytes(FRAME_BYTES)
            if self.overflow:
                # Overflow means audio was lost; keep the take, never auto-send it.
                raise self.capture_error
            speech = self.vad.speech(frame)
            if speech:
                last_speech = time.monotonic()
                self.revision += 1
                self.probability = None
                if self.output and self.display_state == 'paused':
                    self.state('speaking')
            capped = self.endpoint.active and self.endpoint.length + 1 >= self.endpoint.max_frames
            event = self.endpoint.update(speech)
            if self.output:
                self.output.write(frame)
                if self.cue:
                    self.cue_audio.append(frame)
                if self.turn:
                    self.turn_audio.append(frame)
            else:
                self.preroll.append(frame)
            if event == 'start':
                self.take = Path(self.call('begin'))
                self.output = (self.take / 'dictate.raw').open('ab', buffering=0)
                self.output.write(b''.join(self.preroll))
                if self.turn:
                    self.turn_audio.extend(self.preroll)
                if self.cue:
                    self.cue_audio.extend(self.preroll)
                self.preroll.clear()
                self.state('speaking')
            elif event == 'end':
                if self.turn:
                    self.turn_decision('recording_cap' if capped else 'silence_timeout')
                self.finish()
            if self.turn:
                self.check_turn()
            if self.cue:
                self.check_cue()

    def close(self):
        self.stopping.set()
        if self.output:
            self.output.close()
        if self.executor:
            self.executor.shutdown(wait=False, cancel_futures=True)
        if self.cue_executor:
            self.cue_executor.shutdown(wait=False, cancel_futures=True)
        if self.capture:
            self.capture.terminate()
            try:
                self.capture.wait(timeout=.3)
            except subprocess.TimeoutExpired:
                self.capture.kill()
                self.capture.wait()
            self.capture.stdout.close()


def load_turn():
    enabled = os.environ.get('TALKEY_SMART_TURN', '0')
    if enabled not in ('0', '1'):
        raise ValueError('TALKEY_SMART_TURN must be 0 or 1')
    if enabled == '0':
        return None
    silence = setting('VAD_SILENCE_MS', '1200', 160, 10000)
    minimum = setting('TURN_MIN_SILENCE_MS', '2000', 160, 60000)
    maximum = setting('TURN_MAX_SILENCE_MS', '20000', 160, 120000)
    setting('TURN_THRESHOLD', '0.9', .01, .99)
    if maximum < max(silence, minimum):
        raise ValueError('TURN_MAX_SILENCE_MS must be at least the VAD and turn minimum silence')
    data = Path(os.environ.get('TALKEY_DATA_DIR', Path(__file__).resolve().parent.parent))
    if not (data / 'lib/smart_turn.py').is_file():
        data = Path('/usr/share/talkey')
    sys.path.insert(0, str(data / 'lib'))
    from smart_turn import SmartTurn
    turn = SmartTurn()
    turn.probability(bytes(32000))  # Validate features and model before recording.
    return turn


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--check', action='store_true')
    args = parser.parse_args()
    signal.signal(signal.SIGTERM, stop_requested)
    signal.signal(signal.SIGINT, stop_requested)
    vad = listener = None
    try:
        # Validate timing before touching the microphone or enabling auto mode.
        setting('VAD_START_MS', '160', 32, 2000)
        setting('VAD_SILENCE_MS', '1200', 160, 10000)
        setting('VAD_THRESHOLD', '0.5', .01, .99)
        setting('MAX_REC_S', '900', 1, 86400)
        setting('AUTO_IDLE_S', '120', 0, 86400)
        setting('END_PHRASE_SILENCE_MS', '600', 160, 10000)
        phrase = os.environ.get('TALKEY_END_PHRASE', '').strip()
        if phrase and strip_end_cue(phrase, phrase) is None:
            raise ValueError('TALKEY_END_PHRASE must contain words')
        vad = Silero()
        turn = load_turn()
        if not args.check:
            listener = Listener(vad, turn)
            listener.run()
    except StopRequested:
        pass
    except Exception as error:
        print(f'talkey auto: {error}', file=sys.stderr)
        if listener:
            try:
                listener.call('error')
            except (Exception, StopRequested):
                pass
        return 1
    finally:
        if listener:
            listener.close()
        if vad:
            vad.close()
    return 0


if __name__ == '__main__':
    sys.exit(main())
