#!/usr/bin/env bash
# Checkout entry point; packaged installations use this same launcher.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
for _l in "${TALKEY_DATA_DIR:-/nonexistent}/lib" "$SCRIPT_DIR/../lib" /usr/share/talkey/lib; do
  if [[ -f "$_l/common.sh" ]]; then . "$_l/common.sh"; break; fi
done
exec "$DATA_DIR/integrations/eww/talkey-hud" "$@"
